<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FocusGuard.Ipc.Windows/FocusGuard.Ipc.Windows.csproj" />
    <ProjectReference Include="../FocusGuard.Ipc.ColdIdentityProbe/FocusGuard.Ipc.ColdIdentityProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyColdIdentityProbe" AfterTargets="Build">
    <ItemGroup><ColdIdentityProbeFiles Include="../FocusGuard.Ipc.ColdIdentityProbe/bin/$(Configuration)/$(TargetFramework)/*" /></ItemGroup>
    <Copy SourceFiles="@(ColdIdentityProbeFiles)" DestinationFolder="$(OutDir)ColdIdentityProbe" />
  </Target>
</Project>
