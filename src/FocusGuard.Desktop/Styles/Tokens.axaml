<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Theme-independent tokens: geometry, typography, motion, and the per-profile
       accent. Every colour that differs between Dark Zen and White Zen lives in
       Styles/Theme.Dark.axaml and Styles/Theme.Light.axaml instead, keyed by theme
       variant from App.axaml. -->

  <!-- Per-profile accent. FocusViewModel overwrites these at runtime from
       Profile.AccentHex, resolved against the active Catppuccin flavour. Its reach is
       deliberately narrow: the ring, and the few indicators that read as "this is the
       profile you are in". Every other colour in the app belongs to the theme, so
       switching profile never repaints surfaces, borders or primary actions. It stays
       outside the theme dictionaries because a runtime assignment lands in
       Application.Resources and has to win in both flavours. -->
  <Color x:Key="ProfileAccentColor">#CBA6F7</Color>
  <SolidColorBrush x:Key="ProfileAccent" Color="{DynamicResource ProfileAccentColor}" />
  <SolidColorBrush x:Key="ProfileAccentSoft" Color="#24CBA6F7" />

  <LinearGradientBrush x:Key="ProfileAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#DCC0FA" />
    <GradientStop Offset="0.52" Color="#CBA6F7" />
    <GradientStop Offset="1" Color="#A683CB" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ProfileAccentSelectionGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#52CBA6F7" />
    <GradientStop Offset="1" Color="#28CBA6F7" />
  </LinearGradientBrush>

  <!-- Calm Windows geometry: compact controls and generous modal surfaces. -->
  <CornerRadius x:Key="FgRadiusCompact">7</CornerRadius>
  <CornerRadius x:Key="FgRadiusSmall">10</CornerRadius>
  <CornerRadius x:Key="FgRadiusMedium">14</CornerRadius>
  <CornerRadius x:Key="FgRadiusLarge">20</CornerRadius>
  <CornerRadius x:Key="FgRadiusExtraLarge">28</CornerRadius>
  <CornerRadius x:Key="FgRadiusPill">999</CornerRadius>

  <!-- Owner-approved calm motion. These curves are non-linear, critically
       damped in feel, and intentionally avoid bounce or overshoot. Enter decelerates
       into place, Exit accelerates away, Emphasized carries the one transition the
       app is allowed to make theatrical: configuration turning into a live session. -->
  <SplineEasing x:Key="FgEaseHover" X1="0.22" Y1="1" X2="0.36" Y2="1" />
  <SplineEasing x:Key="FgEaseFocus" X1="0.16" Y1="1" X2="0.3" Y2="1" />
  <SplineEasing x:Key="FgEaseStandard" X1="0.2" Y1="0" X2="0" Y2="1" />
  <SplineEasing x:Key="FgEaseEnter" X1="0.05" Y1="0.7" X2="0.1" Y2="1" />
  <SplineEasing x:Key="FgEaseExit" X1="0.3" Y1="0" X2="0.8" Y2="0.15" />
  <SplineEasing x:Key="FgEaseEmphasized" X1="0.2" Y1="0" X2="0" Y2="1" />
  <x:TimeSpan x:Key="FgMotionInstant">0:0:0.08</x:TimeSpan>
  <x:TimeSpan x:Key="FgMotionFast">0:0:0.14</x:TimeSpan>
  <x:TimeSpan x:Key="FgMotionStandard">0:0:0.22</x:TimeSpan>
  <x:Double x:Key="FgModeSwitchWidth">300</x:Double>
  <x:Double x:Key="FgModeSwitchHeight">48</x:Double>
  <x:Double x:Key="FgModeSwitchThumbWidth">147</x:Double>
  <x:Double x:Key="FgModeSwitchTravel">147</x:Double>
  <x:Double x:Key="FgCycleSelectorWidth">630</x:Double>
  <x:Double x:Key="FgCycleCardWidth">196</x:Double>
  <x:Double x:Key="FgCycleTimelineWidth">470</x:Double>
  <x:TimeSpan x:Key="FgMotionSlow">0:0:0.32</x:TimeSpan>
  <x:TimeSpan x:Key="FgMotionEmphasized">0:0:0.52</x:TimeSpan>

  <x:Double x:Key="FgControlHeight">40</x:Double>

  <!-- One button scale for the whole app, taken from the strict wizard's footer. Every
       button reads at this height with this weight; emphasis is carried by colour and
       width, never by a taller box. Compact only narrows the padding, so a dense row of
       buttons still sits on the same baseline as a modal's primary action. -->
  <x:Double x:Key="FgButtonHeight">38</x:Double>
  <Thickness x:Key="FgButtonPadding">18,0</Thickness>
  <Thickness x:Key="FgButtonPaddingCompact">12,0</Thickness>
  <x:Double x:Key="FgTitleBarHeight">32</x:Double>
  <x:Double x:Key="FgCaptionButtonWidth">46</x:Double>
  <x:Double x:Key="FgSidebarWidth">208</x:Double>

  <!-- The three-column shell. Navigation on the left and the contextual list on the
       right are both fixed: only the centre column, which owns the screen's one real
       decision, absorbs the window's width. Both flanks group their content at the
       top and leave the space below empty rather than distributing items to fill a
       height they do not need. -->
  <x:Double x:Key="FgNavSidebarWidth">212</x:Double>
  <x:Double x:Key="FgNavSidebarWidthCompact">212</x:Double>
  <!-- Both flanks are the same width. They carry different content, but an app frame
       whose two edges differ by 80 px reads as accidental rather than composed. -->
  <x:Double x:Key="FgContextSidebarWidth">264</x:Double>
  <x:Double x:Key="FgContextSidebarWidthCompact">228</x:Double>
  <x:Double x:Key="FgCenterColumnMaxWidth">560</x:Double>
  <!-- Below this window width the right column drops to its compact size; the centre
       column is never the one that pays for a narrow window. -->
  <x:Double x:Key="FgShellCompactBreakpoint">1180</x:Double>

  <!-- Navigation rows: compact height, generous pointer target, icon on the left. -->
  <x:Double x:Key="FgNavItemHeight">40</x:Double>
  <x:Double x:Key="FgNavIconSize">16</x:Double>
  <x:Double x:Key="FgProfileDotSize">7</x:Double>

  <!-- The active ring is a status readout, not the hero it was in idle, where the
       redesign replaces it with an editable duration. -->
  <x:Double x:Key="FgActiveRingDiameter">288</x:Double>

  <!-- The segmented control is deliberately narrower than the column it sits in: it
       switches between two modes, and a full-width switch reads as a tab bar. Thumb
       travel is exactly half the track's inner width, so the two halves are equal. -->
  <x:Double x:Key="FgSegmentedWidth">320</x:Double>
  <x:Double x:Key="FgSegmentedHeight">34</x:Double>
  <x:Double x:Key="FgSegmentedThumbWidth">156</x:Double>

  <x:Double x:Key="FgFontScreenTitle">21</x:Double>
  <x:Double x:Key="FgFontDurationValue">42</x:Double>

  <!-- The strict wizard is a fixed 470 wide. Its consumers bind this with
       StaticResource, not DynamicResource: a deferred width lets the first measure run
       unbounded, and the banners inside laid out their text on a single line that the
       later width could no longer reflow. -->
  <x:Double x:Key="FgStrictModalWidth">470</x:Double>
  <!-- The owner reference reads best at 13% quieter scale: 240 × .87 = 208.8,
       rounded to 209 device-independent pixels. The center copy and stroke follow
       the same ratio so idle and active states keep one visual cadence. -->
  <x:Double x:Key="FgTimerDiameter">209</x:Double>
  <x:Double x:Key="FgTimerCopyWidth">157</x:Double>
  <x:Double x:Key="FgTimerRingStrokeThickness">9</x:Double>
  <x:Double x:Key="FgTimerValueFontSize">43.5</x:Double>
  <x:Double x:Key="FgTimerCaptionFontSize">14</x:Double>
  <Thickness x:Key="FgTimerGlowOuterMargin">-8</Thickness>
  <Thickness x:Key="FgTimerGlowMargin">5</Thickness>
  <Thickness x:Key="FgTimerRingInset">5</Thickness>

  <x:Double x:Key="FgFontEyebrow">11</x:Double>
  <x:Double x:Key="FgFontCaption">13</x:Double>
  <x:Double x:Key="FgFontBody">14</x:Double>
  <x:Double x:Key="FgFontTitle">22</x:Double>
  <x:Double x:Key="FgFontModalTitle">24</x:Double>

  <!-- The profile name is the modal's real heading and is centred like one, so it
       outranks the 24 px modal title rather than sitting at field size. -->
  <x:Double x:Key="FgFontNameField">28</x:Double>

  <!-- Header scale: the profile name is the real title. 31.25 is exactly 25% larger
       than its previous 25 px size; the metric remains subordinate at 30. -->
  <x:Double x:Key="FgFontProfileName">31.25</x:Double>
  <x:Double x:Key="FgFontMetric">30</x:Double>
  <x:Double x:Key="FgFontMetricUnit">16</x:Double>
  <x:Double x:Key="FgHeaderHeight">120</x:Double>
  <x:Double x:Key="FgAccentBarWidth">5</x:Double>

  <!-- Vertical rhythm. One scale, applied by meaning rather than by eye: tighter
       values bind a label to its control, wider ones separate whole functional
       blocks. Views should reach for these instead of typing a number. -->
  <x:Double x:Key="FgSpaceHairline">4</x:Double>
  <x:Double x:Key="FgSpaceTight">8</x:Double>
  <x:Double x:Key="FgSpaceSnug">12</x:Double>
  <x:Double x:Key="FgSpaceItem">16</x:Double>
  <x:Double x:Key="FgSpaceGroup">28</x:Double>
  <x:Double x:Key="FgSpaceSection">40</x:Double>
  <x:Double x:Key="FgSpaceHero">56</x:Double>

  <!-- The same scale expressed as top margins, because a StackPanel's uniform Spacing
       cannot express "these two belong together, that one starts a new block". Each
       key is named for what follows it, so a view reads as the rhythm it produces. -->
  <Thickness x:Key="FgGapRing">0,40,0,0</Thickness>
  <Thickness x:Key="FgGapSelector">0,36,0,0</Thickness>
  <Thickness x:Key="FgGapModeContent">0,22,0,0</Thickness>
  <Thickness x:Key="FgGapBlocking">0,36,0,0</Thickness>
  <Thickness x:Key="FgGapCardSibling">0,16,0,0</Thickness>
  <Thickness x:Key="FgGapAction">0,32,0,0</Thickness>
  <Thickness x:Key="FgGapLists">0,36,0,0</Thickness>
  <Thickness x:Key="FgGapItem">0,16,0,0</Thickness>
  <Thickness x:Key="FgGapTight">0,8,0,0</Thickness>

  <!-- The content column is fixed rather than fluid: a focus screen that reflows as
       the window is dragged stops feeling like one stable place. -->
  <x:Double x:Key="FgContentColumnWidth">720</x:Double>
  <x:Double x:Key="FgAppHeaderHeight">64</x:Double>
  <!-- How far the header's progressive blur reaches past its own bar before it has
       fully faded out. -->
  <x:Double x:Key="FgHeaderBlurFalloff">40</x:Double>
  <x:Double x:Key="FgSettingsSheetWidth">560</x:Double>
  <!-- The Settings section rail. Narrower than the app's nav column because its labels
       are single words, and fixed so the content pane never reflows as sections change. -->
  <x:Double x:Key="FgSettingsRailWidth">168</x:Double>
  <!-- Minimum pointer targets: icon affordances at 40, primary actions at 44. -->
  <x:Double x:Key="FgTargetMin">40</x:Double>
  <x:Double x:Key="FgTargetPrimary">44</x:Double>
</ResourceDictionary>
