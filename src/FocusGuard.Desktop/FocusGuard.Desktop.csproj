<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Compiled bindings turn a mistyped binding path into a build error. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FocusGuard.Ipc.Windows/FocusGuard.Ipc.Windows.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FocusGuard.Platform.Windows/FocusGuard.Platform.Windows.csproj" />
    <ProjectReference Include="../FocusGuard.Client/FocusGuard.Client.csproj" />
    <ProjectReference Include="../FocusGuard.Domain/FocusGuard.Domain.csproj" />
    <ProjectReference Include="../FocusGuard.Contracts/FocusGuard.Contracts.csproj" />
    <ProjectReference Include="../FocusGuard.Storage/FocusGuard.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../assets/branding/focusguard-icon.png" Link="Assets/focusguard-icon.png" />
    <AvaloniaResource Include="../../assets/branding/header-niebla.jpg" Link="Assets/header-niebla.jpg" />
    <AvaloniaResource Include="../../assets/branding/fonts/Geist-*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/branding/fonts/OFL-Geist.txt" Link="Assets/Fonts/OFL-Geist.txt" />
  </ItemGroup>
</Project>
