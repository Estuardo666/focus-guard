<Window
    x:Class="FocusGuard.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FocusGuard.Desktop"
    xmlns:storage="using:FocusGuard.Storage"
    xmlns:resources="using:FocusGuard.Desktop.Resources"
    x:DataType="vm:FocusViewModel"
    Title="FocusGuard"
    Width="1040"
    Height="720"
    MinWidth="880"
    MinHeight="620"
    Background="{DynamicResource FgSurface0}"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1">

  <Grid>
    <!-- Row 0 is our own title bar: it spans the full window width, not just the
         content area, so the caption buttons sit where Windows users expect them. -->
    <Grid x:Name="ApplicationShell" RowDefinitions="32,*">
      <Grid.Effect>
        <BlurEffect Radius="0">
          <BlurEffect.Transitions>
            <Transitions>
              <DoubleTransition Property="Radius" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
            </Transitions>
          </BlurEffect.Transitions>
        </BlurEffect>
      </Grid.Effect>

    <Grid
        Grid.Row="0"
        ColumnDefinitions="*,Auto"
        Background="{DynamicResource FgSurface1}"
        PointerPressed="TitleBarPointerPressed">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
        <Border Width="14" Height="14" CornerRadius="{DynamicResource FgRadiusSmall}" Background="{DynamicResource FgAccent}" />
        <TextBlock
            Text="FocusGuard"
            FontSize="{DynamicResource FgFontCaption}"
            Foreground="{DynamicResource FgTextSecondary}"
            VerticalAlignment="Center" />
        <!-- Remaining time repeated here so it is legible from the taskbar hover. -->
        <TextBlock
            Text="{Binding TitleBarStatus}"
            IsVisible="{Binding HasTitleBarStatus}"
            FontSize="{DynamicResource FgFontCaption}"
            Foreground="{DynamicResource FgAccent}"
            VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
        <Button
            Theme="{StaticResource FgCaptionButton}"
            Content="&#xE921;"
            Click="MinimizeClick"
            AutomationProperties.Name="{x:Static resources:UiStrings.MinimizeWindow}" />
        <Button
            Theme="{StaticResource FgCaptionButton}"
            Content="&#xE922;"
            Click="MaximizeClick"
            AutomationProperties.Name="{x:Static resources:UiStrings.MaximizeWindow}" />
        <Button
            Theme="{StaticResource FgCloseButton}"
            Content="&#xE8BB;"
            Click="CloseClick"
            AutomationProperties.Name="{x:Static resources:UiStrings.CloseWindow}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="208,*">

      <!-- Sidebar -->
      <Border
          Grid.Column="0"
          Background="{DynamicResource FgSurface1}"
          BorderBrush="{DynamicResource FgBorder}"
          BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto" Margin="10,4,10,14">
          <StackPanel Spacing="2">
            <Button
                Theme="{StaticResource FgNavButton}"
                Classes.active="{Binding IsFocusVisible}"
                Click="FocusNavigationClick"
                AutomationProperties.Name="{x:Static resources:UiStrings.FocusNavigation}">
              <Grid ColumnDefinitions="18,*,Auto">
                <TextBlock Classes="icon" Text="&#xE916;" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{x:Static resources:UiStrings.FocusNavigation}" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button
                Theme="{StaticResource FgNavButton}"
                Classes.active="{Binding IsProfilesVisible}"
                IsEnabled="{Binding CanNavigateToEditors}"
                Click="ProfilesNavigationClick"
                ToolTip.Tip="{x:Static resources:UiStrings.NavigationLockedHint}"
                AutomationProperties.Name="{x:Static resources:UiStrings.ProfilesNavigation}">
              <Grid ColumnDefinitions="18,*,Auto">
                <TextBlock Classes="icon" Text="&#xE71D;" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{x:Static resources:UiStrings.ProfilesNavigation}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="icon" FontSize="11" Text="&#xE72E;" IsVisible="{Binding IsNavigationLocked}" />
              </Grid>
            </Button>

            <Button
                Theme="{StaticResource FgNavButton}"
                IsEnabled="{Binding CanNavigateToEditors}"
                ToolTip.Tip="{x:Static resources:UiStrings.NavigationLockedHint}"
                AutomationProperties.Name="{x:Static resources:UiStrings.ScheduleNavigation}">
              <Grid ColumnDefinitions="18,*,Auto">
                <TextBlock Classes="icon" Text="&#xE787;" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{x:Static resources:UiStrings.ScheduleNavigation}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="icon" FontSize="11" Text="&#xE72E;" IsVisible="{Binding IsNavigationLocked}" />
              </Grid>
            </Button>

            <Button
                Theme="{StaticResource FgNavButton}"
                Classes.active="{Binding IsActivityVisible}"
                Click="ActivityNavigationClick"
                AutomationProperties.Name="{x:Static resources:UiStrings.ActivityNavigation}">
              <Grid ColumnDefinitions="18,*,Auto">
                <TextBlock Classes="icon" Text="&#xEB05;" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{x:Static resources:UiStrings.ActivityTitle}" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button
                Theme="{StaticResource FgNavButton}"
                Classes.active="{Binding IsSettingsVisible}"
                Click="SettingsNavigationClick"
                AutomationProperties.Name="{x:Static resources:UiStrings.SettingsNavigation}">
              <Grid ColumnDefinitions="18,*,Auto">
                <TextBlock Classes="icon" Text="&#xE713;" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{x:Static resources:UiStrings.SettingsNavigation}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="3" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" FontSize="12" Text="&#xE73E;" Foreground="{DynamicResource FgSuccess}" />
              <TextBlock
                  Text="{x:Static resources:UiStrings.ProtectionStatus}"
                  FontSize="{DynamicResource FgFontCaption}"
                  Foreground="{DynamicResource FgSuccess}" />
            </StackPanel>
            <TextBlock
                Text="{Binding ServiceHealthLabel}"
                TextWrapping="Wrap"
                FontSize="{DynamicResource FgFontCaption}"
                Foreground="{DynamicResource FgTextTertiary}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Content -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="{DynamicResource FgMainSurface}">

        <!-- Session header. The profile name is the title; the metric sits at 30 px so it
             never competes with it, and the profile swatches go bottom-left rather than
             top-right so they cannot collide with the figure. The 5 px accent bar is the
             only element that changes colour between profiles. -->
        <Border
            Grid.Row="0"
            BorderBrush="{DynamicResource FgBorder}"
            BorderThickness="0,0,0,1"
            ClipToBounds="True">
          <Grid ColumnDefinitions="5,*">
            <Rectangle Fill="{Binding ProfileAccentBrush}" />

            <Panel Grid.Column="1">
              <!-- UniformToFill anchored right: narrowing the window crops the flat, dark
                   left third and keeps the haze on the right, where the metric sits.
                   Fill alone would stretch the gradient out of shape. -->
              <Border>
                <Border.Background>
                  <ImageBrush
                      Source="avares://FocusGuard.Desktop/Assets/header-niebla.jpg"
                      Stretch="UniformToFill"
                      AlignmentX="Right"
                      AlignmentY="Center" />
                </Border.Background>
              </Border>

              <!-- Fades the artwork into the body instead of cutting it off hard. -->
              <Border Background="{DynamicResource FgHeaderFadeGradient}" />

              <Grid ColumnDefinitions="*,Auto" Margin="22,20">
                <StackPanel Spacing="6" HorizontalAlignment="Left">
                  <!-- Idle: the name is the profile picker. -->
                  <Button
                      x:Name="ProfileButton"
                      Classes="ghost profilePicker"
                      Padding="10,6"
                      MinHeight="0"
                      HorizontalAlignment="Left"
                      IsVisible="{Binding IsInactive}"
                      Click="ProfilesNavigationClick"
                      AutomationProperties.Name="{x:Static resources:UiStrings.SwitchProfile}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock
                          Classes="profileName"
                          Text="{Binding ProfileName}"
                          VerticalAlignment="Center" />
                      <TextBlock
                          Classes="icon"
                          FontSize="12"
                          Text="&#xE70D;"
                          Foreground="{DynamicResource FgTextTertiary}" />
                    </StackPanel>
                  </Button>

                  <!-- Active: the name stops being clickable and takes the badge. -->
                  <StackPanel
                      Orientation="Horizontal"
                      Spacing="9"
                      Margin="10,6,0,0"
                      HorizontalAlignment="Left"
                      IsVisible="{Binding IsActive}">
                    <TextBlock Classes="profileName" Text="{Binding ProfileName}" />
                    <Border Classes="pill success" VerticalAlignment="Center" Padding="9,4">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource FgSuccess}" />
                        <TextBlock
                            Text="{x:Static resources:UiStrings.ProtectedBadge}"
                            FontSize="{DynamicResource FgFontEyebrow}"
                            Foreground="{DynamicResource FgSuccess}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <TextBlock
                      Classes="secondary"
                      Text="{Binding HeaderSubtitle}"
                      TextWrapping="Wrap"
                      MaxWidth="440"
                      Margin="10,0,0,0"
                      HorizontalAlignment="Left"
                      TextAlignment="Left" />

                  <!-- Swatches vanish during a session rather than dimming. -->
                  <StackPanel
                      Orientation="Horizontal"
                      Spacing="5"
                      Margin="10,6,0,0"
                      HorizontalAlignment="Left"
                      IsVisible="{Binding HasProfileSwatches}">
                    <ItemsControl ItemsSource="{Binding ProfileSwatches}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileSwatchViewModel">
                          <Button
                              Classes="profileSwatch"
                              Background="{Binding SwatchBrush}"
                              Click="ProfileSwatchClick"
                              ToolTip.Tip="{Binding Name}"
                              AutomationProperties.Name="{Binding Name}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button
                        Classes="profileSwatch addSwatch"
                        Content="&#xE710;"
                        Click="ProfilesNavigationClick"
                        ToolTip.Tip="{x:Static resources:UiStrings.AddProfile}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.AddProfile}" />
                  </StackPanel>
                </StackPanel>

                <!-- One value that mutates: countdown in accent while running, the day's
                     total otherwise, and on first run a sentence instead of a zero. -->
                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                  <!-- Foreground is set on the container so every run inherits the accent
                       during a session, while the unit style overrides only the h and m. -->
                  <ItemsControl
                      ItemsSource="{Binding MetricSegments}"
                      Foreground="{Binding MetricBrush}"
                      IsVisible="{Binding HasMetric}"
                      HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MetricSegmentViewModel">
                        <TextBlock
                            Classes="metric"
                            Classes.unit="{Binding IsUnit}"
                            Text="{Binding Text}"
                            VerticalAlignment="Bottom" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock
                      Classes="metricCaption"
                      Text="{Binding MetricLabel}"
                      IsVisible="{Binding HasMetric}"
                      HorizontalAlignment="Right" />
                  <TextBlock
                      Classes="secondary"
                      Text="{x:Static resources:UiStrings.FirstSessionHint}"
                      IsVisible="{Binding HasMetricPlaceholder}"
                      TextAlignment="Right"
                      HorizontalAlignment="Right" />
                  <vm:WeekSparkline
                      Height="26"
                      Margin="0,6,0,0"
                      Days="{Binding WeekMinutes}"
                      Accent="{Binding ProfileAccentBrush}"
                      BarBrush="{DynamicResource FgSurface3}"
                      IsVisible="{Binding HasHistory}"
                      HorizontalAlignment="Right"
                      AutomationProperties.Name="{x:Static resources:UiStrings.WeekSparklineLabel}" />
                </StackPanel>
              </Grid>
            </Panel>
          </Grid>
        </Border>

        <!-- Focus section -->
        <ScrollViewer Grid.Row="1" Classes="screen" IsVisible="{Binding IsFocusVisible}">
          <StackPanel Margin="28,20" Spacing="16">

            <!-- Idle: one card holds duration, strict mode, enforcement and the single
                 primary action, so the state you start in is visible from the button. -->
            <Border Classes="card" IsVisible="{Binding IsInactive}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                <Panel Width="112" Height="112" VerticalAlignment="Center">
                  <Border Classes="ringGlowOuter" Margin="-7" />
                  <Border Classes="ringGlow" Margin="5" />
                  <Ellipse Stroke="{DynamicResource FgTrackGradient}" StrokeThickness="9" Margin="5" />
                  <Arc
                      Margin="5"
                      Stroke="{DynamicResource FgProgressGradient}"
                      StrokeThickness="9"
                      StrokeLineCap="Round"
                      StartAngle="-90"
                      SweepAngle="{Binding RingSweepAngle}" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding RingCenterValue}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="{Binding RingCenterCaption}"
                        Classes="caption"
                        FontSize="{DynamicResource FgFontEyebrow}"
                        HorizontalAlignment="Center" />
                  </StackPanel>
                </Panel>

                <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                  <StackPanel Spacing="8">
                    <ListBox
                        ItemsSource="{Binding DurationChoices}"
                        SelectedItem="{Binding SelectedDurationPreset}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        ItemContainerTheme="{StaticResource FgPresetItem}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.DurationLabel}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DurationPresetViewModel">
                          <TextBlock Text="{Binding ShortLabel}" ToolTip.Tip="{Binding Label}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding IsCustomDurationSelected}">
                      <TextBlock
                          Text="{x:Static resources:UiStrings.DurationCustomLabel}"
                          Classes="caption"
                          VerticalAlignment="Center" />
                      <NumericUpDown
                          Width="120"
                          Minimum="1"
                          Maximum="720"
                          Increment="5"
                          FormatString="0"
                          Value="{Binding CustomDurationMinutes}"
                          AutomationProperties.Name="{x:Static resources:UiStrings.DurationCustomLabel}" />
                    </StackPanel>
                  </StackPanel>

                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="icon" FontSize="13" Text="&#xE72E;" Foreground="{DynamicResource FgTextSecondary}" />
                      <TextBlock Text="{x:Static resources:UiStrings.RealBlocking}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        Theme="{StaticResource FgToggleSwitch}"
                        OnContent=""
                        OffContent=""
                        IsChecked="{Binding IsEnforcementEnabled}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.EnableEnforcement}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="icon" FontSize="13" Text="&#xE72E;" Foreground="{DynamicResource FgTextSecondary}" />
                      <TextBlock Text="{x:Static resources:UiStrings.StrictMode}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Row="1"
                        Grid.Column="1"
                        Theme="{StaticResource FgToggleSwitch}"
                        OnContent=""
                        OffContent=""
                        IsChecked="{Binding IsStrictMode}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.StrictMode}" />
                  </Grid>

                  <TextBlock
                      Classes="caption"
                      Text="{Binding StrictModeDescription}"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Classes="primary"
                    Content="{x:Static resources:UiStrings.StartFocus}"
                    Command="{Binding StartFocusCommand}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Start focus session" />
              </Grid>
            </Border>

            <!-- Active: the timer is the only thing the app needs to say while running,
                 so the rule lists drop out of the body entirely. -->
            <Border Classes="card" IsVisible="{Binding IsActive}" Padding="20,28">
              <StackPanel Spacing="22" HorizontalAlignment="Center">
                <Panel Width="158" Height="158">
                  <!-- Only the running ring breathes; a pulsing halo on an idle screen is noise. -->
                  <Border Classes="ringGlowOuter pulsing" Margin="-9" />
                  <Border Classes="ringGlow pulsing" Margin="6" />
                  <Ellipse Stroke="{DynamicResource FgTrackGradient}" StrokeThickness="10" Margin="6" />
                  <Arc
                      Margin="6"
                      Stroke="{DynamicResource FgProgressGradient}"
                      StrokeThickness="10"
                      StrokeLineCap="Round"
                      StartAngle="-90"
                      SweepAngle="{Binding RingSweepAngle}" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding RingCenterValue}"
                        FontSize="34"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Remaining focus time" />
                    <TextBlock
                        Text="{Binding RingCenterCaption}"
                        Classes="caption"
                        FontSize="{DynamicResource FgFontCaption}"
                        HorizontalAlignment="Center" />
                  </StackPanel>
                </Panel>

                <Button
                    Classes="danger"
                    Content="{x:Static resources:UiStrings.StopNormalFocus}"
                    Command="{Binding StopFocusCommand}"
                    IsVisible="{Binding CanStop}"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Stop active normal focus session" />

                <!-- Strict mode removes the button rather than greying it out. -->
                <TextBlock
                    Classes="caption"
                    Text="{Binding StrictActiveNotice}"
                    IsVisible="{Binding IsStrictSessionActive}"
                    TextWrapping="Wrap"
                    MaxWidth="380"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsActive}" Padding="16">
              <StackPanel Spacing="4">
                <TextBlock Classes="metricLabel" Text="{x:Static resources:UiStrings.BlockedAttemptsLabel}" />
                <TextBlock Classes="metricValue" Text="{Binding BlockedAttemptsText}" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsActive}" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{x:Static resources:UiStrings.RecentBlocks}" FontWeight="SemiBold" />
                  <Button
                      Grid.Column="1"
                      Classes="link"
                      Content="{x:Static resources:UiStrings.ViewAll}"
                      Click="ActivityNavigationClick" />
                </Grid>
                <TextBlock
                    Classes="caption"
                    Text="{x:Static resources:UiStrings.ActivityEmpty}"
                    IsVisible="{Binding !HasRecentBlocks}" />
                <ItemsControl ItemsSource="{Binding RecentBlocks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityEventViewModel">
                      <Grid ColumnDefinitions="18,*,Auto" Margin="0,4">
                        <TextBlock Classes="icon" FontSize="13" Text="{Binding Glyph}" Foreground="{DynamicResource FgTextSecondary}" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Target}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Classes="caption" Text="{Binding RelativeTimeText}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Rule chips sit side by side: a chip is a tenth of the old row height,
                 so both lists fit without scrolling. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding IsInactive}">
              <Border Classes="card" Padding="16">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding WebsitesHeader}" FontWeight="SemiBold" />
                    <Button
                        Grid.Column="1"
                        Classes="iconOnly"
                        Content="&#xE710;"
                        Click="ProfilesNavigationClick"
                        IsEnabled="{Binding CanNavigateToEditors}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.AddWebsiteRule}" />
                  </Grid>
                  <TextBlock
                      Classes="caption"
                      Text="{x:Static resources:UiStrings.NoBlockedWebsites}"
                      IsVisible="{Binding !HasSavedWebsiteRules}" />
                  <ItemsControl ItemsSource="{Binding VisibleWebsiteRules}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SavedWebsiteRuleViewModel">
                        <Border Classes="chip" ToolTip.Tip="{Binding Rule.Action}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                Text="{Binding Rule.Pattern}"
                                FontSize="{DynamicResource FgFontCaption}"
                                VerticalAlignment="Center" />
                            <Button
                                Classes="chipClose"
                                Content="&#xE711;"
                                Command="{Binding RemoveCommand}"
                                AutomationProperties.Name="{x:Static resources:UiStrings.RemoveRule}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button
                      Classes="link"
                      HorizontalAlignment="Left"
                      Content="{Binding WebsiteOverflowText}"
                      IsVisible="{Binding HasWebsiteOverflow}"
                      Click="ExpandWebsiteRulesClick" />
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="16">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ApplicationsHeader}" FontWeight="SemiBold" />
                    <Button
                        Grid.Column="1"
                        Classes="iconOnly"
                        Content="&#xE710;"
                        Click="ProfilesNavigationClick"
                        IsEnabled="{Binding CanNavigateToEditors}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.AddApplicationRule}" />
                  </Grid>
                  <TextBlock
                      Classes="caption"
                      Text="{x:Static resources:UiStrings.NoBlockedApplications}"
                      IsVisible="{Binding !HasSavedApplicationRules}" />
                  <ItemsControl ItemsSource="{Binding VisibleApplicationRules}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SavedApplicationRuleViewModel">
                        <Border Classes="chip" ToolTip.Tip="{Binding Rule.MatchKind}">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                Text="{Binding Rule.Value}"
                                FontSize="{DynamicResource FgFontCaption}"
                                VerticalAlignment="Center" />
                            <Button
                                Classes="chipClose"
                                Content="&#xE711;"
                                Command="{Binding RemoveCommand}"
                                AutomationProperties.Name="{x:Static resources:UiStrings.RemoveRule}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button
                      Classes="link"
                      HorizontalAlignment="Left"
                      Content="{Binding ApplicationOverflowText}"
                      IsVisible="{Binding HasApplicationOverflow}"
                      Click="ExpandApplicationRulesClick" />
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsInactive}">
              <TextBlock Classes="icon" FontSize="12" Text="&#xE946;" Foreground="{DynamicResource FgTextTertiary}" />
              <TextBlock
                  Classes="caption"
                  Foreground="{DynamicResource FgTextTertiary}"
                  Text="{x:Static resources:UiStrings.ChangesNextSession}"
                  VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Classes="caption" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <!-- Profiles section: the only place rules are edited. -->
        <ScrollViewer Grid.Row="1" Classes="screen" IsVisible="{Binding IsProfilesVisible}">
          <StackPanel Margin="28,20" Spacing="16">
            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.ProfileLabel}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox
                        x:Name="ProfileSelector"
                        MinWidth="240"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile}"
                        AutomationProperties.Name="Stored focus profile">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="storage:StoredProfile">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="1"
                        Content="{x:Static resources:UiStrings.DuplicateProfile}"
                        Command="{Binding DuplicateProfileCommand}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.DuplicateProfile}" />
                  </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.AddWebsiteRule}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding WebsiteRuleInput}" PlaceholderText="example.com" AutomationProperties.Name="Website rule" />
                      <Button Grid.Column="1" Content="{x:Static resources:UiStrings.Add}" Command="{Binding AddWebsiteRuleCommand}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.AddApplicationRule}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding ApplicationRuleInput}" PlaceholderText="FocusGuard.TestTarget.exe" AutomationProperties.Name="Application rule" />
                      <Button Grid.Column="1" Content="{x:Static resources:UiStrings.Add}" Command="{Binding AddApplicationRuleCommand}" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <Border Classes="card" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding WebsitesHeader}" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.NoBlockedWebsites}" IsVisible="{Binding !HasSavedWebsiteRules}" />
                  <ItemsControl ItemsSource="{Binding SavedWebsiteRules}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SavedWebsiteRuleViewModel">
                        <Border Classes="chip">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Rule.Pattern}" FontSize="{DynamicResource FgFontCaption}" VerticalAlignment="Center" />
                            <Button Classes="chipClose" Content="&#xE711;" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove saved website rule" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="{Binding ApplicationsHeader}" FontWeight="SemiBold" />
                  <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.NoBlockedApplications}" IsVisible="{Binding !HasSavedApplicationRules}" />
                  <ItemsControl ItemsSource="{Binding SavedApplicationRules}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SavedApplicationRuleViewModel">
                        <Border Classes="chip">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding Rule.Value}" FontSize="{DynamicResource FgFontCaption}" VerticalAlignment="Center" />
                            <Button Classes="chipClose" Content="&#xE711;" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove saved application rule" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.FutureSessionsOnly}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <!-- Activity section -->
        <ScrollViewer Grid.Row="1" Classes="screen" IsVisible="{Binding IsActivityVisible}">
          <StackPanel Margin="28,20" Spacing="12">
            <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.ActivityDescription}" />
            <Border Classes="card" IsVisible="{Binding IsActivityEmpty}" Padding="16">
              <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.ActivityEmpty}" />
            </Border>
            <ItemsControl ItemsSource="{Binding ActivityEvents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityEventViewModel">
                  <Border Classes="card" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="18,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                      <TextBlock Classes="icon" FontSize="13" Text="{Binding Glyph}" Foreground="{DynamicResource FgTextSecondary}" />
                      <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding KindLabel}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding LocalTimeText}" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Outcome}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Settings section -->
        <ScrollViewer Grid.Row="1" Classes="screen" IsVisible="{Binding IsSettingsVisible}">
          <StackPanel Margin="28,20" Spacing="16">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Static resources:UiStrings.SystemHealth}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding ServiceHealthLabel}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EnforcementWarning}" TextWrapping="Wrap" Foreground="{DynamicResource FgWarning}" />
              </StackPanel>
            </Border>
            <!-- The summary is the moment the loop closes, but forcing a window on
                 someone who has already moved on is its own kind of rudeness. -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding SessionEndTitle}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding SessionEndDescription}" TextWrapping="Wrap" />
                <ComboBox
                    ItemsSource="{Binding SessionEndOptions}"
                    SelectedItem="{Binding SelectedSessionEndOption}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding SessionEndTitle}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionEndOptionViewModel">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Static resources:UiStrings.SessionAuthority}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.SessionAuthorityDescription}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      </Grid>
    </Grid>

    <!-- Strict review is intentionally in-window: it preserves context, blocks the
         shell, and can animate out before it leaves the accessibility tree. -->
    <Border
        x:Name="StrictReviewOverlay"
        Background="{DynamicResource FgModalScrim}"
        IsVisible="False"
        IsHitTestVisible="False"
        Opacity="0"
        Focusable="True"
        KeyDown="StrictReviewKeyDown">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
        </Transitions>
      </Border.Transitions>

      <Border
          x:Name="StrictReviewDialog"
          Classes="strictModal"
          Width="840"
          MaxWidth="840"
          MaxHeight="648"
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          KeyboardNavigation.TabNavigation="Cycle"
          Opacity="0"
          RenderTransform="scale(0.97)"
          RenderTransformOrigin="50%,50%"
          AutomationProperties.Name="{x:Static resources:UiStrings.ReviewStrictFocus}">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
          </Transitions>
        </Border.Transitions>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid Margin="24,22,24,18" ColumnDefinitions="64,*" ColumnSpacing="18">
              <Border
                  Width="58"
                  Height="58"
                  CornerRadius="{DynamicResource FgRadiusPill}"
                  Background="{DynamicResource FgAccentSoft}"
                  HorizontalAlignment="Left">
                <TextBlock
                    Classes="icon"
                    Text="&#xE72E;"
                    FontSize="28"
                    Foreground="{DynamicResource FgAccent}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Static resources:UiStrings.ReviewStrictFocus}"
                    FontSize="24"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="{Binding StrictEndTimeDescription}"
                    Foreground="{DynamicResource FgTextSecondary}"
                    TextWrapping="Wrap"
                    AutomationProperties.Name="Strict focus exact end time" />
              </StackPanel>
            </Grid>

            <Border Classes="strictWarning" Margin="24,0,24,18">
              <Grid ColumnDefinitions="20,Auto,*" ColumnSpacing="9">
                <TextBlock
                    Classes="icon"
                    Text="&#xE7BA;"
                    Foreground="{DynamicResource FgWarning}"
                    FontSize="15"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Static resources:UiStrings.SaveRecoveryCodeTitle}"
                    Foreground="{DynamicResource FgWarning}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Static resources:UiStrings.SaveRecoveryCodeDetail}"
                    Foreground="{DynamicResource FgTextSecondary}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="strictBody">
              <StackPanel>
                <StackPanel Margin="20,18,20,20" Spacing="10">
                  <TextBlock
                      Classes="caption"
                      Text="{x:Static resources:UiStrings.RecoveryCodeLabel}" />
                  <Grid ColumnDefinitions="42,*,42" ColumnSpacing="8">
                    <Border
                        Width="42"
                        Height="48"
                        CornerRadius="{DynamicResource FgRadiusLarge}"
                        Background="{DynamicResource FgSurface3}">
                      <TextBlock
                          Classes="icon"
                          Text="&#xE8D7;"
                          FontSize="16"
                          Foreground="{DynamicResource FgTextSecondary}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    </Border>
                    <TextBox
                        Grid.Column="1"
                        Classes="recoveryCode"
                        Text="{Binding RecoveryCodeDisplay}"
                        IsReadOnly="True"
                        AutomationProperties.Name="One-time recovery code" />
                    <Button
                        Grid.Column="2"
                        Classes="recoveryCopy"
                        Content="&#xE8C8;"
                        Click="CopyRecoveryCodeClick"
                        AutomationProperties.Name="{x:Static resources:UiStrings.CopyRecoveryCode}" />
                  </Grid>
                </StackPanel>

                <Border BorderBrush="{DynamicResource FgDivider}" BorderThickness="0,1,0,0">
                  <StackPanel Margin="20,14" Spacing="14">
                    <Grid ColumnDefinitions="28,*">
                      <CheckBox
                          Theme="{StaticResource FgCheckBox}"
                          IsChecked="{Binding AcknowledgeRecoverySaved}"
                          AutomationProperties.Name="Acknowledge recovery code saved" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            Text="{x:Static resources:UiStrings.SavedRecoveryCode}"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Classes="caption"
                            Text="{x:Static resources:UiStrings.SavedRecoveryCodeDetail}" />
                      </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource FgDivider}" BorderThickness="0,1,0,0" />

                    <Grid ColumnDefinitions="28,*">
                      <CheckBox
                          Theme="{StaticResource FgCheckBox}"
                          IsChecked="{Binding AcknowledgeUnsavedWork}"
                          AutomationProperties.Name="Acknowledge unsaved work warning" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            Text="{x:Static resources:UiStrings.SavedAffectedWork}"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Classes="caption"
                            Text="{x:Static resources:UiStrings.SavedAffectedWorkDetail}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource FgDivider}" BorderThickness="0,1,0,0">
                  <StackPanel Margin="20,16,20,20" Spacing="10">
                    <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                      <TextBlock
                          Classes="icon"
                          Text="&#xE72E;"
                          Foreground="{DynamicResource FgAccent}"
                          FontSize="14"
                          VerticalAlignment="Center" />
                      <TextBlock
                          Grid.Column="1"
                          Text="{x:Static resources:UiStrings.StrictConsequence}"
                          Foreground="{DynamicResource FgTextSecondary}"
                          TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        Text="{Binding StrictConfirmationPromptText}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource FgTextPrimary}" />
                    <TextBox
                        x:Name="StrictConfirmationInput"
                        Text="{Binding TypedConfirmation}"
                        PlaceholderText="{x:Static resources:UiStrings.TypeSentenceExactly}"
                        AutomationProperties.Name="Strict focus two-word confirmation phrase" />

                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right">
                      <Button
                          Classes="strictCancel"
                          Content="{x:Static resources:UiStrings.Cancel}"
                          Command="{Binding CancelStrictCommand}"
                          AutomationProperties.Name="Cancel strict focus review" />
                      <Button
                          Classes="primary"
                          Content="{x:Static resources:UiStrings.ActivateStrictFocus}"
                          Command="{Binding ConfirmStrictCommand}"
                          IsEnabled="{Binding CanConfirmStrict}"
                          AutomationProperties.Name="Activate strict focus after confirmation" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>
</Window>
