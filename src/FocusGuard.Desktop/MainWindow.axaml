<Window
    x:Class="FocusGuard.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FocusGuard.Desktop"
    xmlns:storage="using:FocusGuard.Storage"
    xmlns:resources="using:FocusGuard.Desktop.Resources"
    x:DataType="vm:FocusViewModel"
    Title="FocusGuard"
    Width="1440"
    Height="840"
    MinWidth="860" MaxWidth="1440" CanResize="False" CanMaximize="False"
    MinHeight="460" MaxHeight="840" WindowStartupLocation="CenterScreen"
    Background="{DynamicResource FgSurface0}"
    WindowDecorations="Full"
    ExtendClientAreaToDecorationsHint="False">

  <Grid>
    <!-- One ambient surface lives for the entire window lifetime. Timer, Cycles,
         Focus Active, Settings, and strict review all render above this same node. -->
    <Border x:Name="GlobalAmbientBackground" Background="{DynamicResource FgMainSurface}" />

    <Grid x:Name="ApplicationShell">
      <Grid.Effect>
        <BlurEffect Radius="0">
          <BlurEffect.Transitions>
            <Transitions>
              <DoubleTransition Property="Radius" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
            </Transitions>
          </BlurEffect.Transitions>
        </BlurEffect>
      </Grid.Effect>

    <!-- The three-column shell. This grid owns the first column for the entire life of
         the window: navigation is a place, not a bar that appears and disappears with
         the screen under it. The second column hosts whichever section is showing, and
         the contextual third column belongs to that section rather than to the shell,
         because only Focus has a list that stays true next to it. -->
    <Grid x:Name="ShellColumns" ColumnDefinitions="Auto,*">

      <Border x:Name="NavigationSidebar" Classes="navSidebar" IsEnabled="{Binding !IsSessionSetupOpen}">
       <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="24" Margin="0,4,0,24">
         <TextBlock Text="FocusGuard" FontSize="18" FontWeight="SemiBold" Margin="10,0" />
         <Button Classes="primary" Click="NewSessionClick" IsEnabled="{Binding CanStart}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static resources:UiStrings.HomeNewSession}"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Classes="fluentIcon" Text="&#xE710;" /><TextBlock Text="{x:Static resources:UiStrings.HomeNewSession}" /></StackPanel></Button>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="navItem navItemQuiet" Classes.selected="{Binding IsSettingsVisible}" Click="SettingsNavigationClick" AutomationProperties.Name="{x:Static resources:UiStrings.SettingsNavigation}"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="fluentIcon navIcon" Text="&#xE713;" /><TextBlock Text="{x:Static resources:UiStrings.SettingsNavigation}" /></StackPanel></Button>
        <ScrollViewer x:Name="NavigationScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
         <StackPanel Spacing="6">
          <Button Classes="navItem" Classes.selected="{Binding IsFocusVisible}" Click="FocusNavigationClick" AutomationProperties.Name="{x:Static resources:UiStrings.HomeSessions}"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="fluentIcon navIcon" Text="&#xE8A5;" /><TextBlock Text="{x:Static resources:UiStrings.HomeSessions}" /></StackPanel></Button>
          <Button Classes="navItem" Classes.selected="{Binding IsProfilesVisible}" IsEnabled="{Binding CanNavigateToEditors}" Click="ProfilesNavigationClick" AutomationProperties.Name="{x:Static resources:UiStrings.NavProfilesGroup}"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="fluentIcon navIcon" Text="&#xE8D4;" /><TextBlock Text="{x:Static resources:UiStrings.NavProfilesGroup}" /></StackPanel></Button>
          <Button Classes="navItem" Classes.selected="{Binding IsScheduleVisible}" IsEnabled="{Binding CanNavigateToEditors}" Click="ScheduleNavigationClick" AutomationProperties.Name="{x:Static resources:UiStrings.ScheduleNavigation}"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="fluentIcon navIcon" Text="&#xE787;" /><TextBlock Text="{x:Static resources:UiStrings.ScheduleNavigation}" /></StackPanel></Button>
          <Button Classes="navItem" Classes.selected="{Binding IsActivityVisible}" Click="ActivityNavigationClick" AutomationProperties.Name="{x:Static resources:UiStrings.ActivityTitle}"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Classes="fluentIcon navIcon" Text="&#xE9D2;" /><TextBlock Text="{x:Static resources:UiStrings.ActivityTitle}" /></StackPanel></Button>
         </StackPanel>
        </ScrollViewer>
       </DockPanel>
      </Border>

    <Grid Grid.Column="1">

      <!-- Content -->
      <Grid RowDefinitions="*" Background="Transparent">


        <!-- Focus section. Timer, Cycles, and Focus Active share this one stable host. -->
        <vm:FocusWorkspaceView Grid.Row="0" IsVisible="{Binding IsFocusVisible}" />


        <!-- Profiles section: the only place rules are edited. -->
        <Grid Grid.Row="0" IsVisible="{Binding IsProfilesVisible}">
          <Grid>
          <Grid>
<Grid Margin="20" ColumnDefinitions="240,*" ColumnSpacing="16" IsVisible="{Binding !IsCreatingProfile}">
<ScrollViewer HorizontalScrollBarVisibility="Disabled">            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.ProfileLabel}" />
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <ComboBox
                        x:Name="ProfileSelector"
                        Width="200"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile}"
                        AutomationProperties.Name="Stored focus profile">
                      <ComboBox.ContextMenu><ContextMenu>
                        <MenuItem Header="{x:Static resources:UiStrings.DuplicateProfile}" Command="{Binding DuplicateProfileCommand}" />
                        <MenuItem Header="{x:Static resources:UiStrings.DeleteProfile}" Command="{Binding DeleteProfileCommand}" />
                      </ContextMenu></ComboBox.ContextMenu>
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="storage:StoredProfile">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        
                        Content="{x:Static resources:UiStrings.NewProfile}"
                        Command="{Binding NewProfileCommand}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.NewProfile}" />
                    <Button
                        
                        Content="{x:Static resources:UiStrings.DuplicateProfile}"
                        Command="{Binding DuplicateProfileCommand}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.DuplicateProfile}" />
                    <Button
                        
                        Classes="danger"
                        Content="{x:Static resources:UiStrings.DeleteProfile}"
                        Command="{Binding DeleteProfileCommand}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.DeleteProfile}" />
                  </WrapPanel>
                  <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.ProfileNameLabel}" />
                  <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <TextBox
                        Text="{Binding ProfileNameInput}"
                        MaxLength="80"
                        AutomationProperties.Name="{x:Static resources:UiStrings.ProfileNameLabel}" />
                    <Button
                        Grid.Row="1"
                        Content="{x:Static resources:UiStrings.RenameProfile}"
                        Command="{Binding RenameProfileCommand}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.RenameProfile}" />
                  </Grid>
                  <TextBlock
                      Classes="caption"
                      Foreground="{DynamicResource FgWarning}"
                      Text="{Binding ProfileNameValidationMessage}"
                      TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.ProfileColorLabel}" />
                  <ItemsControl ItemsSource="{Binding ProfileColors}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProfileColorOptionViewModel">
                        <Button
                            Classes="zenSwatch"
                            Command="{Binding SelectCommand}"
                            AutomationProperties.Name="{Binding Hex}">
                          <Border
                              Width="20"
                              Height="20"
                              CornerRadius="{DynamicResource FgRadiusPill}"
                              Background="{Binding Swatch}">
                            <TextBlock
                                Classes="icon"
                                Text="{Binding SelectionGlyph}"
                                FontSize="10"
                                Foreground="{DynamicResource FgPrimaryButtonForeground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border
                      Background="{DynamicResource FgDangerSoft}"
                      BorderBrush="{DynamicResource FgDanger}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource FgRadiusMedium}"
                      IsVisible="{Binding IsDeleteProfileConfirmationVisible}"
                      Padding="14"
                      AutomationProperties.Name="{x:Static resources:UiStrings.DeleteProfileConfirmationTitle}">
                    <StackPanel Spacing="10">
                      <TextBlock
                          Text="{x:Static resources:UiStrings.DeleteProfileConfirmationTitle}"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource FgDanger}" />
                      <TextBlock Text="{Binding DeleteProfileConfirmationText}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button
                            Content="{x:Static resources:UiStrings.KeepProfile}"
                            Command="{Binding CancelProfileDeleteCommand}"
                            AutomationProperties.Name="{x:Static resources:UiStrings.KeepProfile}" />
                        <Button
                            Classes="danger"
                            Content="{x:Static resources:UiStrings.ConfirmDeleteProfile}"
                            Command="{Binding ConfirmProfileDeleteCommand}"
                            AutomationProperties.Name="{x:Static resources:UiStrings.ConfirmDeleteProfile}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

              </StackPanel>
            </Border>
</ScrollViewer>
<ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">            <vm:RuleEditorView x:Name="ProfileRules" />

            <!-- Break exceptions belong directly under the two lists they carve out of.
                 They are not a third kind of rule: they name which of the entries above
                 survive the release that every break performs. -->
            <Expander Header="{x:Static resources:UiStrings.BreakExceptions}">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock
                      Text="{x:Static resources:UiStrings.BreakExceptions}"
                      FontWeight="SemiBold" />
                  <TextBlock
                      Classes="caption"
                      Text="{x:Static resources:UiStrings.BreakExceptionsHint}"
                      TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.BreakExceptionSite}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox
                          Text="{Binding BreakWebsiteInput}"
                          PlaceholderText="{x:Static resources:UiStrings.BreakWebsiteInput}"
                          AutomationProperties.Name="{x:Static resources:UiStrings.BreakWebsiteInput}" />
                      <Button
                          Grid.Column="1"
                          Content="{x:Static resources:UiStrings.Add}"
                          Command="{Binding AddBreakWebsiteCommand}"
                          AutomationProperties.Name="{x:Static resources:UiStrings.AddBreakException}" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.BreakExceptionApp}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox
                          Text="{Binding BreakApplicationInput}"
                          PlaceholderText="{x:Static resources:UiStrings.BreakApplicationInput}"
                          AutomationProperties.Name="{x:Static resources:UiStrings.BreakApplicationInput}" />
                      <Button
                          Grid.Column="1"
                          Content="{x:Static resources:UiStrings.Add}"
                          Command="{Binding AddBreakApplicationCommand}"
                          AutomationProperties.Name="{x:Static resources:UiStrings.AddBreakException}" />
                    </Grid>
                  </StackPanel>
                </Grid>

                <TextBlock
                    Classes="caption"
                    Text="{x:Static resources:UiStrings.NoBreakExceptions}"
                    TextWrapping="Wrap"
                    IsVisible="{Binding !HasBreakRules}" />
                <ItemsControl ItemsSource="{Binding BreakRules}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreakRuleViewModel">
                      <Border Classes="chip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock
                              Classes="fluentIcon"
                              Text="{Binding Glyph}"
                              FontSize="{DynamicResource FgFontCaption}"
                              VerticalAlignment="Center" />
                          <TextBlock
                              Text="{Binding Display}"
                              FontSize="{DynamicResource FgFontCaption}"
                              VerticalAlignment="Center" />
                          <Button
                              Classes="chipClose"
                              Content="&#xE711;"
                              Command="{Binding RemoveCommand}"
                              AutomationProperties.Name="Remove break exception" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>

            <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.FutureSessionsOnly}" TextWrapping="Wrap" />
</StackPanel></ScrollViewer></Grid>

          </Grid>
          </Grid>

        </Grid>

        <Grid Grid.Row="0" IsVisible="{Binding IsScheduleVisible}">
          <vm:ScheduleView Margin="20" />
        </Grid>

        <!-- Activity section -->
        <ScrollViewer Grid.Row="0" Classes="screen" IsVisible="{Binding IsActivityVisible}">
          <StackPanel Margin="20" Spacing="12">
            <vm:TodayView />
            <Expander Header="{x:Static resources:UiStrings.TechnicalLog}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="12" Margin="0,12,0,0">
                <TextBlock Text="{Binding TechnicalLogError}" Foreground="{DynamicResource FgWarning}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.ActivityDescription}" />
            <Border Classes="card" IsVisible="{Binding IsActivityEmpty}" Padding="16">
              <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.ActivityEmpty}" />
            </Border>
            <ItemsControl ItemsSource="{Binding ActivityEvents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityEventViewModel">
                  <Border Classes="card" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="18,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                      <TextBlock Classes="icon" FontSize="13" Text="{Binding Glyph}" Foreground="{DynamicResource FgTextSecondary}" />
                      <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding KindLabel}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding LocalTimeText}" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Outcome}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <!-- Settings section -->
        <ScrollViewer Grid.Row="0" Classes="screen" IsVisible="False">
          <StackPanel Margin="20" Spacing="16">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Static resources:UiStrings.SystemHealth}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding ServiceHealthLabel}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EnforcementWarning}" TextWrapping="Wrap" Foreground="{DynamicResource FgWarning}" />
              </StackPanel>
            </Border>
            <!-- The summary is the moment the loop closes, but forcing a window on
                 someone who has already moved on is its own kind of rudeness. -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding SessionEndTitle}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding SessionEndDescription}" TextWrapping="Wrap" />
                <ComboBox
                    ItemsSource="{Binding SessionEndOptions}"
                    SelectedItem="{Binding SelectedSessionEndOption}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{Binding SessionEndTitle}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionEndOptionViewModel">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>
            <!-- Theme is a comfort setting, not a preference buried in a menu: one
                 switch, applied on the spot so the choice can be judged by looking. -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding AppearanceTitle}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding AppearanceDescription}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding AppearanceLightLabel}" VerticalAlignment="Center" />
                  <ToggleSwitch
                      Grid.Column="1"
                      Theme="{StaticResource FgToggleSwitch}"
                      OnContent=""
                      OffContent=""
                      IsChecked="{Binding IsLightTheme}"
                      AutomationProperties.Name="{Binding AppearanceLightLabel}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding StartupTitle}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding StartupDescription}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding StartupToggleLabel}" VerticalAlignment="Center" />
                  <ToggleSwitch
                      Grid.Column="1"
                      Theme="{StaticResource FgToggleSwitch}"
                      OnContent=""
                      OffContent=""
                      IsChecked="{Binding StartsWithWindows}"
                      AutomationProperties.Name="{Binding StartupToggleLabel}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Static resources:UiStrings.SessionAuthority}" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{x:Static resources:UiStrings.SessionAuthorityDescription}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- The floating header is gone. Its navigation became the left column, its
           settings icon the foot of that column, and its wordmark the window's own
           title bar, so no content scrolls underneath a bar that has to stay legible
           over it. Sections no longer reserve a top inset for a header that is not
           there. -->
      </Grid>
    </Grid>
    </Grid>

    <!-- Settings is a centered modal. Header and horizontal tabs stay fixed while
         each tab owns its own scroll region. -->
    <Border
        x:Name="SettingsOverlay"
        Background="{DynamicResource FgModalScrim}"
        IsVisible="False"
        IsHitTestVisible="False"
        Opacity="0"
        Focusable="True"
        PointerPressed="SettingsOverlayPointerPressed"
        KeyDown="SettingsKeyDown"
        AutomationProperties.Name="{x:Static resources:UiStrings.SettingsNavigation}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource FgMotionStandard}" Easing="{DynamicResource FgEaseFocus}" />
        </Transitions>
      </Border.Transitions>

      <Border
          x:Name="SettingsDialog"
          Classes="settingsModal"
          Width="860"
          MaxWidth="860"
          MaxHeight="620"
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          KeyboardNavigation.TabNavigation="Cycle"
          Opacity="0"
          RenderTransform="translateY(8px) scale(0.985)"
          RenderTransformOrigin="50%,50%">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="{DynamicResource FgMotionStandard}" Easing="{DynamicResource FgEaseFocus}" />
            <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource FgMotionStandard}" Easing="{DynamicResource FgEaseFocus}" />
          </Transitions>
        </Border.Transitions>

        <!-- Same three-part composition as the strict wizard: a header block, the body,
             and a separated footer band carrying the one action that closes the modal. -->
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Margin="22,20,22,14" Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock
                  Classes="wizardStep"
                  Text="{x:Static resources:UiStrings.SettingsNavigation}" />
              <Button
                  Grid.Column="1"
                  Classes="modalClose"
                  Content="&#xE8BB;"
                  Click="SettingsCloseClick"
                  AutomationProperties.Name="{x:Static resources:UiStrings.SettingsClose}" />
            </Grid>
            <TextBlock
                Classes="wizardTitle"
                Text="{x:Static resources:UiStrings.SettingsTitle}"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="wizardBody"
                Text="{x:Static resources:UiStrings.SettingsSubtitle}"
                TextWrapping="Wrap" />
          </StackPanel>

          <TabControl
              x:Name="SettingsTabs"
              Grid.Row="1"
              Margin="22,0,22,0"
              Classes="settingsTabs"
              SelectedIndex="0"
              AutomationProperties.Name="Settings categories">
            <TabItem Header="{x:Static resources:UiStrings.SettingsGeneralTab}">
                <StackPanel Classes="settingsContent" Spacing="28">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding AppearanceTitle}" Classes="settingsSectionTitle" />
                    <Border Classes="settingsGroup">
                      <StackPanel>
                        <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding AppearanceLightLabel}" />
                            <TextBlock Text="{Binding AppearanceDescription}" Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" Theme="{StaticResource FgToggleSwitch}" OnContent="" OffContent="" IsChecked="{Binding IsLightTheme}" AutomationProperties.Name="{Binding AppearanceLightLabel}" />
                        </Grid>
                        <Border Classes="settingsDivider" />
                        <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{x:Static resources:UiStrings.SettingsProfileTheme}" />
                            <TextBlock Text="{x:Static resources:UiStrings.SettingsProfileThemeDescription}" Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" Theme="{StaticResource FgToggleSwitch}" OnContent="" OffContent="" IsChecked="{Binding UsesProfileThemeOverride}" AutomationProperties.Name="{x:Static resources:UiStrings.SettingsProfileTheme}" />
                        </Grid>
                        <Border Classes="settingsDivider" />
                        <Grid Classes="settingsRow" ColumnDefinitions="*,Auto" IsEnabled="{Binding UsesProfileThemeOverride}">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{x:Static resources:UiStrings.SettingsProfileAppearance}" />
                            <TextBlock Text="{x:Static resources:UiStrings.SettingsProfileAppearanceDescription}" Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" Theme="{StaticResource FgToggleSwitch}" OnContent="" OffContent="" IsChecked="{Binding IsProfileLightTheme}" AutomationProperties.Name="{Binding AppearanceLightLabel}" />
                        </Grid>
                        <Border Classes="settingsDivider" />
                        <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{x:Static resources:UiStrings.SettingsReduceMotion}" />
                            <TextBlock Text="{x:Static resources:UiStrings.SettingsReduceMotionDescription}" Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" Theme="{StaticResource FgToggleSwitch}" OnContent="" OffContent="" IsChecked="{Binding IsReduceMotionEnabled}" AutomationProperties.Name="{x:Static resources:UiStrings.SettingsReduceMotion}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static resources:UiStrings.SettingsBehaviorSection}" Classes="settingsSectionTitle" />
                    <Border Classes="settingsGroup">
                      <Grid Classes="settingsRow" ColumnDefinitions="*,280">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding SessionEndTitle}" />
                          <TextBlock Text="{Binding SessionEndDescription}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SessionEndOptions}" SelectedItem="{Binding SelectedSessionEndOption}" AutomationProperties.Name="{Binding SessionEndTitle}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionEndOptionViewModel"><TextBlock Text="{Binding Label}" /></DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </Border>
                  </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static resources:UiStrings.SettingsNotificationsTab}">
                <StackPanel Classes="settingsContent" Spacing="12">
                  <TextBlock Text="{x:Static resources:UiStrings.SettingsNotificationsDescription}" Classes="caption" TextWrapping="Wrap" />
                  <Border Classes="settingsGroup">
                    <StackPanel>
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto" IsEnabled="False"><TextBlock Text="{x:Static resources:UiStrings.SettingsSessionReminders}" /><TextBlock Grid.Column="1" Text="{x:Static resources:UiStrings.SettingsUnavailable}" Classes="caption" /></Grid>
                      <Border Classes="settingsDivider" />
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto"><TextBlock Text="{x:Static resources:UiStrings.SettingsBreakNotifications}" /><ToggleSwitch Grid.Column="1" Theme="{StaticResource FgToggleSwitch}" OnContent="" OffContent="" IsChecked="{Binding AreCyclePhaseNotificationsEnabled}" AutomationProperties.Name="{x:Static resources:UiStrings.SettingsBreakNotifications}" /></Grid>
                      <Border Classes="settingsDivider" />
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto"><TextBlock Text="{x:Static resources:UiStrings.SettingsWeeklySummary}" /><TextBlock Grid.Column="1" Text="{x:Static resources:UiStrings.SettingsUnavailable}" Classes="caption" /></Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static resources:UiStrings.SettingsStartupTab}">
                <StackPanel Classes="settingsContent" Spacing="12">
                  <TextBlock Text="{Binding StartupDescription}" Classes="caption" TextWrapping="Wrap" />
                  <Border Classes="settingsGroup">
                    <StackPanel>
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto"><TextBlock Text="{Binding StartupToggleLabel}" /><ToggleSwitch Grid.Column="1" Theme="{StaticResource FgToggleSwitch}" OnContent="" OffContent="" IsChecked="{Binding StartsWithWindows}" /></Grid>
                      <Border Classes="settingsDivider" />
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto" IsEnabled="False"><TextBlock Text="{x:Static resources:UiStrings.SettingsStartMinimized}" /><TextBlock Grid.Column="1" Text="{x:Static resources:UiStrings.SettingsUnavailable}" Classes="caption" /></Grid>
                      <Border Classes="settingsDivider" />
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto" IsEnabled="False"><TextBlock Text="{x:Static resources:UiStrings.SettingsShowInTray}" /><ToggleSwitch Grid.Column="1" Theme="{StaticResource FgToggleSwitch}" IsChecked="True" /></Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static resources:UiStrings.SettingsIntegrationsTab}">
                <StackPanel Classes="settingsContent">
                  <Border Classes="settingsGroup">
                    <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3"><TextBlock Text="{x:Static resources:UiStrings.SettingsBrowserExtension}" /><TextBlock Text="{Binding ServiceHealthLabel}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding StatusPillText}" Foreground="{DynamicResource FgSuccess}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static resources:UiStrings.SettingsProtectionTab}">
                <StackPanel Classes="settingsContent" Spacing="12">
                  <Border Classes="settingsGroup">
                    <StackPanel>
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3"><TextBlock Text="{x:Static resources:UiStrings.SettingsProtectionService}" /><TextBlock Text="{Binding ServiceHealthLabel}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusPillText}" Foreground="{DynamicResource FgSuccess}" VerticalAlignment="Center" />
                      </Grid>
                      <Border Classes="settingsDivider" />
                      <!-- Whether blocking is actually enforced is a property of the
                           install, not a choice to re-make before every session, so it
                           lives here rather than on the Focus screen. It is still the
                           user's switch: turning it off leaves a countdown that blocks
                           nothing, which the row says outright. -->
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto" IsEnabled="{Binding CanNavigateToEditors}">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{x:Static resources:UiStrings.RealBlocking}" />
                          <TextBlock Text="{Binding EnforcementWarning}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            Theme="{StaticResource FgToggleSwitch}"
                            OnContent=""
                            OffContent=""
                            IsChecked="{Binding IsEnforcementEnabled}"
                            AutomationProperties.Name="{x:Static resources:UiStrings.EnableEnforcement}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Classes="settingsNotice"><TextBlock Text="{Binding EnforcementWarning}" Foreground="{DynamicResource FgWarning}" TextWrapping="Wrap" /></Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="{x:Static resources:UiStrings.SettingsAdvancedTab}">
                <StackPanel Classes="settingsContent">
                  <Border Classes="settingsGroup" IsEnabled="False">
                    <StackPanel>
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto"><TextBlock Text="{x:Static resources:UiStrings.SettingsRecoveryCode}" /><TextBlock Grid.Column="1" Text="{x:Static resources:UiStrings.SettingsUnavailable}" Classes="caption" /></Grid>
                      <Border Classes="settingsDivider" />
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto"><TextBlock Text="{x:Static resources:UiStrings.SettingsExportLogs}" /><TextBlock Grid.Column="1" Text="{x:Static resources:UiStrings.SettingsUnavailable}" Classes="caption" /></Grid>
                      <Border Classes="settingsDivider" />
                      <Grid Classes="settingsRow" ColumnDefinitions="*,Auto"><TextBlock Text="{x:Static resources:UiStrings.SettingsResetAll}" Foreground="{DynamicResource FgDanger}" /><TextBlock Grid.Column="1" Text="{x:Static resources:UiStrings.SettingsUnavailable}" Classes="caption" /></Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
            </TabItem>
          </TabControl>

          <Border Grid.Row="2" Classes="wizardFooter" Margin="0,16,0,0">
            <Button
                Classes="primary modalPrimary"
                HorizontalAlignment="Right"
                Content="{x:Static resources:UiStrings.SettingsDone}"
                Click="SettingsCloseClick"
                AutomationProperties.Name="{x:Static resources:UiStrings.SettingsDone}" />
          </Border>
        </Grid>
      </Border>
    </Border>

    <!-- Profile creation shares Strict Mode's root-level modal boundary, card
         chrome, and enter/exit transition. -->
    <Border
        x:Name="NewProfileOverlay"
        Background="{DynamicResource FgModalScrim}"
        IsVisible="False"
        IsHitTestVisible="False"
        Opacity="0"
        Focusable="True"
        KeyDown="NewProfileKeyDown"
        AutomationProperties.Name="{x:Static resources:UiStrings.CreateProfile}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
        </Transitions>
      </Border.Transitions>

      <Border
          x:Name="NewProfileDialog"
          Classes="strictModal"
          Width="840"
          MaxWidth="840"
          MaxHeight="648"
          Margin="24"
         
          VerticalAlignment="Center"
          KeyboardNavigation.TabNavigation="Cycle"
          Opacity="0"
          RenderTransform="scale(0.97)"
          RenderTransformOrigin="50%,50%"
          AutomationProperties.Name="{x:Static resources:UiStrings.NewProfileTitle}">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
          </Transitions>
        </Border.Transitions>

      <!-- Same composition as the strict wizard: header block, scrolling body, and a
           separated footer band. The centred medallion and the corner close button are
           gone: the title says what this is, and Cancel lives in the footer with the
           action it is the alternative to, instead of in the opposite corner. -->
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="22,20,22,14" Spacing="3">
          <TextBlock Classes="wizardStep" Text="{x:Static resources:UiStrings.NewProfile}" />
          <TextBlock
              Classes="wizardTitle"
              Text="{x:Static resources:UiStrings.NewProfileTitle}"
              TextWrapping="Wrap" />
          <TextBlock
              Classes="wizardBody"
              Text="{x:Static resources:UiStrings.NewProfileDescription}"
              TextWrapping="Wrap" />
        </StackPanel>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Border Classes="strictBody">
        <StackPanel>
          <StackPanel Margin="20,18,20,20" Spacing="6">
            <TextBlock
                Classes="caption"
                Text="{x:Static resources:UiStrings.ProfileNameLabel}"
                />
            <TextBox
                x:Name="NewProfileNameInput"
                Classes="nameField"
                Text="{Binding NewProfileNameInput}"
                MaxLength="80"
               
                AutomationProperties.Name="{x:Static resources:UiStrings.ProfileNameLabel}" />
            <TextBlock
                Classes="caption"
                Foreground="{DynamicResource FgWarning}"
                Text="{Binding NewProfileNameValidationMessage}"
                TextWrapping="Wrap"
 />
          </StackPanel>

          <Border BorderBrush="{DynamicResource FgDivider}" BorderThickness="0,1,0,0">
            <StackPanel Margin="20,16,20,12" Spacing="9">
              <TextBlock
                  Text="{x:Static resources:UiStrings.ProfileColorLabel}"
                  FontWeight="SemiBold"
 />
              <TextBlock
                  Classes="caption"
                  Text="{x:Static resources:UiStrings.ProfileColorHint}"
                  TextWrapping="Wrap"
 />
              <ItemsControl ItemsSource="{Binding NewProfileColors}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileColorOptionViewModel">
                    <Button
                        Classes="zenSwatch"
                        Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding Hex}">
                      <Border
                          Width="20"
                          Height="20"
                          CornerRadius="{DynamicResource FgRadiusPill}"
                          Background="{Binding Swatch}">
                        <TextBlock
                            Classes="icon"
                            Text="{Binding SelectionGlyph}"
                            FontSize="10"
                            Foreground="{DynamicResource FgPrimaryButtonForeground}"
                           
                            VerticalAlignment="Center" />
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource FgDivider}" BorderThickness="0,1,0,0">
          <StackPanel Margin="20,16,20,20" Spacing="9">
            <TextBlock
                Text="{x:Static resources:UiStrings.NewProfileSuggestionsLabel}"
                FontWeight="SemiBold"
 />
            <TextBlock
                Classes="caption"
                Text="{x:Static resources:UiStrings.NewProfileSuggestionsHint}"
                TextWrapping="Wrap"
 />
            <ItemsControl ItemsSource="{Binding NewProfileSuggestions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileSuggestionViewModel">
                  <!-- Chip shows only the pretty domain: the label is redundant with
                       it and the tooltip already carries the full domain list. -->
                  <ToggleButton
                      Classes="suggestion"
                      IsChecked="{Binding IsSelected}"
                      ToolTip.Tip="{Binding DomainSummary}"
                      AutomationProperties.Name="{Binding Label}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border
                          Classes="suggestionCheck"
                          Width="{Binding CheckWidth}"
                          Opacity="{Binding CheckOpacity}">
                        <TextBlock
                            Classes="icon"
                            Text="{Binding SelectionGlyph}"
                            FontSize="11"
                            Foreground="{DynamicResource FgAccent}"
                            VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="{Binding DomainSummary}" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource FgDivider}" BorderThickness="0,1,0,0">
          <StackPanel Margin="20,16,20,20" Spacing="7">
            <TextBlock
                Classes="caption"
                Text="{x:Static resources:UiStrings.NewProfileCustomRuleLabel}"
 />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Width="460">
              <TextBox
                  Text="{Binding NewProfileCustomRuleInput}"
                  PlaceholderText="{x:Static resources:UiStrings.NewProfileCustomRulePlaceholder}"
                  AutomationProperties.Name="{x:Static resources:UiStrings.NewProfileCustomRuleLabel}" />
              <Button
                  Grid.Column="1"
                  Content="{x:Static resources:UiStrings.Add}"
                  Command="{Binding AddNewProfileCustomRuleCommand}" />
            </Grid>
            <TextBlock
                Classes="caption"
                Foreground="{DynamicResource FgWarning}"
                Text="{Binding NewProfileRuleValidationMessage}"
                TextWrapping="Wrap"
 />
            <ItemsControl ItemsSource="{Binding NewProfileDraftRules}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NewProfileRuleDraftViewModel">
                  <Border Classes="chip">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Classes="caption" Text="{Binding KindLabel}" />
                      <TextBlock Text="{Binding Display}" />
                      <Button
                          Classes="chipClose"
                          Content="&#xE711;"
                          Command="{Binding RemoveCommand}"
                          AutomationProperties.Name="{x:Static resources:UiStrings.RemoveDraftRule}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          </Border>

        </StackPanel>
      </Border>
      </ScrollViewer>

        <!-- The summary sits with the button that acts on it, and the band keeps both
             on screen however long the rule list above grows. -->
        <Border Grid.Row="2" Classes="wizardFooter">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock
                Classes="wizardBody"
                Text="{Binding NewProfileSummaryText}"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button
                  Classes="outline compact"
                  Content="{x:Static resources:UiStrings.Cancel}"
                  Command="{Binding CancelCreateProfileCommand}"
                  AutomationProperties.Name="{x:Static resources:UiStrings.CancelProfileCreation}" />
              <Button
                  Classes="primary modalPrimary"
                  Content="{x:Static resources:UiStrings.CreateProfile}"
                  Command="{Binding CreateProfileCommand}"
                  AutomationProperties.Name="{x:Static resources:UiStrings.CreateProfile}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      </Border>
    </Border>

    <!-- Building a cycle borrows the same modal boundary as profile creation: the
         shelf behind it stays legible as the thing being added to. -->
    <Border
        x:Name="CyclePresetOverlay"
        Background="{DynamicResource FgModalScrim}"
        IsVisible="False"
        IsHitTestVisible="False"
        Opacity="0"
        Focusable="True"
        KeyDown="CyclePresetKeyDown"
        AutomationProperties.Name="{x:Static resources:UiStrings.NewCyclePresetTitle}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
        </Transitions>
      </Border.Transitions>

      <Border
          x:Name="CyclePresetDialog"
          Classes="strictModal"
          Width="640"
          MaxWidth="640"
          MaxHeight="648"
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          KeyboardNavigation.TabNavigation="Cycle"
          Opacity="0"
          RenderTransform="scale(0.97)"
          RenderTransformOrigin="50%,50%">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
          </Transitions>
        </Border.Transitions>

        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Margin="22,20,22,14" Spacing="3">
            <!-- The eyebrow names the category, not the screen: repeating the title
                 verbatim above itself said nothing twice. -->
            <TextBlock Classes="wizardStep" Text="{x:Static resources:UiStrings.CycleEyebrow}" />
            <TextBlock
                Classes="wizardTitle"
                Text="{Binding CyclePresetEditorTitle}"
                TextWrapping="Wrap" />
            <TextBlock
                Classes="wizardBody"
                Text="{x:Static resources:UiStrings.NewCyclePresetDescription}"
                TextWrapping="Wrap" />
          </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Classes="strictBody">
              <StackPanel>
                <StackPanel Margin="20,18,20,20" Spacing="6">
                  <TextBlock
                      Classes="caption"
                      Text="{x:Static resources:UiStrings.CyclePresetNameLabel}"
                      />
                  <TextBox
                      x:Name="CyclePresetNameField"
                      Classes="nameField"
                      Text="{Binding CyclePresetNameInput}"
                      MaxLength="80"
                     
                      AutomationProperties.Name="{x:Static resources:UiStrings.CyclePresetNameLabel}" />
                  <TextBlock
                      Classes="caption"
                      Foreground="{DynamicResource FgWarning}"
                      Text="{Binding CyclePresetNameValidationMessage}"
                      TextWrapping="Wrap"
 />
                </StackPanel>

                <Border BorderBrush="{DynamicResource FgDivider}" BorderThickness="0,1,0,0">
                  <Grid
                      Margin="20,16,20,20"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="16"
                      RowSpacing="10">
                    <TextBlock
                        Classes="caption"
                        Text="{x:Static resources:UiStrings.CycleFocusMinutes}"
                        VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Column="1"
                        Minimum="1"
                        Maximum="180"
                        Increment="5"
                        FormatString="0"
                        Value="{Binding CycleFocusMinutes}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.CycleFocusMinutes}" />

                    <TextBlock
                        Grid.Row="1"
                        Classes="caption"
                        Text="{x:Static resources:UiStrings.CycleShortBreakMinutes}"
                        VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Row="1"
                        Grid.Column="1"
                        Minimum="1"
                        Maximum="60"
                        Increment="1"
                        FormatString="0"
                        Value="{Binding CycleShortBreakMinutes}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.CycleShortBreakMinutes}" />

                    <TextBlock
                        Grid.Row="2"
                        Classes="caption"
                        Text="{x:Static resources:UiStrings.CycleLongBreakMinutes}"
                        VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Row="2"
                        Grid.Column="1"
                        Minimum="1"
                        Maximum="120"
                        Increment="5"
                        FormatString="0"
                        Value="{Binding CycleLongBreakMinutes}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.CycleLongBreakMinutes}" />

                    <TextBlock
                        Grid.Row="3"
                        Classes="caption"
                        Text="{x:Static resources:UiStrings.CycleLongBreakFrequency}"
                        VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Row="3"
                        Grid.Column="1"
                        Minimum="2"
                        Maximum="12"
                        Increment="1"
                        FormatString="0"
                        Value="{Binding CycleLongBreakFrequency}"
                        AutomationProperties.Name="{x:Static resources:UiStrings.CycleLongBreakFrequency}" />
                  </Grid>
                </Border>

                <Border BorderBrush="{DynamicResource FgDivider}" BorderThickness="0,1,0,0">
                  <StackPanel Margin="20,16,20,20" Spacing="10">
                    <TextBlock
                        Text="{x:Static resources:UiStrings.CycleTerminationLabel}"
                        FontWeight="SemiBold" />
                    <ListBox
                        Classes="focusModeSelector"
                        ItemsSource="{Binding CycleTerminationChoices}"
                        SelectedItem="{Binding SelectedCycleTerminationChoice}"
                        ItemContainerTheme="{StaticResource FgModeItem}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Static resources:UiStrings.CycleTerminationLabel}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CycleTerminationChoiceViewModel">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16"
                        IsVisible="{Binding IsCycleCountTermination}">
                      <TextBlock
                          Classes="caption"
                          Text="{x:Static resources:UiStrings.CycleCount}"
                          VerticalAlignment="Center" />
                      <NumericUpDown
                          Grid.Column="1"
                          Minimum="1"
                          Maximum="24"
                          Increment="1"
                          FormatString="0"
                          Value="{Binding CycleCount}"
                          AutomationProperties.Name="{x:Static resources:UiStrings.CycleCount}" />
                    </Grid>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16"
                        IsVisible="{Binding IsTotalDurationTermination}">
                      <TextBlock
                          Classes="caption"
                          Text="{x:Static resources:UiStrings.CycleTotalDurationMinutes}"
                          VerticalAlignment="Center" />
                      <NumericUpDown
                          Grid.Column="1"
                          Minimum="1"
                          Maximum="1440"
                          Increment="15"
                          FormatString="0"
                          Value="{Binding CycleTotalDurationMinutes}"
                          AutomationProperties.Name="{x:Static resources:UiStrings.CycleTotalDurationMinutes}" />
                    </Grid>
                  </StackPanel>
                </Border>

              </StackPanel>
            </Border>
        </ScrollViewer>

          <!-- The draft describes itself in the same sentences the shelf will use, so
               the program is read before it is saved, beside the button that saves it. -->
          <Border Grid.Row="2" Classes="wizardFooter">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock
                  Classes="wizardBody"
                  Text="{Binding CyclePresetDraftSummary}"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{x:Static resources:UiStrings.CycleHowItWorksTitle}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    Classes="outline compact"
                    Content="{x:Static resources:UiStrings.Cancel}"
                    Command="{Binding CancelCyclePresetEditCommand}"
                    AutomationProperties.Name="{x:Static resources:UiStrings.CancelCycleEditing}" />
                <Button
                    Classes="primary modalPrimary"
                    Content="{x:Static resources:UiStrings.SaveCyclePreset}"
                    Command="{Binding CommitCyclePresetCommand}"
                    AutomationProperties.Name="{x:Static resources:UiStrings.SaveCyclePreset}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Border>

    <!-- Strict review is intentionally in-window: it preserves context, blocks the
         shell, and can animate out before it leaves the accessibility tree. -->
    <Border
        x:Name="StrictReviewOverlay"
        Background="{DynamicResource FgModalScrim}"
        IsVisible="False"
        IsHitTestVisible="False"
        Opacity="0"
        Focusable="True"
        KeyDown="StrictReviewKeyDown">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
        </Transitions>
      </Border.Transitions>

      <Border
          x:Name="StrictReviewDialog"
          Classes="strictModal"
          Width="{StaticResource FgStrictModalWidth}"
          MaxWidth="{StaticResource FgStrictModalWidth}"
          Margin="24"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          KeyboardNavigation.TabNavigation="Cycle"
          Opacity="0"
          RenderTransform="scale(0.97)"
          RenderTransformOrigin="50%,50%"
          AutomationProperties.Name="{x:Static resources:UiStrings.ReviewStrictFocus}">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="{DynamicResource FgEaseFocus}" />
          </Transitions>
        </Border.Transitions>

        <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled"><Panel>
          <!-- ════ Step 1: the recovery code ═══════════════════════════════ -->
          <!-- The code is the subject of this step, not a field beside a checkbox.
               Passing it is itself the acknowledgement, which is why no box asks
               the user to promise they saved something. -->
          <StackPanel IsVisible="{Binding IsStrictStepOne}">
            <StackPanel Margin="22,20,22,0" Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="wizardStep" Text="{x:Static resources:UiStrings.StrictStepOne}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="stepDot active"><TextBlock Text="1" /></Border>
                  <Border Classes="stepRule" />
                  <Border Classes="stepDot"><TextBlock Text="2" /></Border>
                </StackPanel>
              </Grid>
              <TextBlock
                  Classes="wizardTitle"
                  Text="{x:Static resources:UiStrings.StrictSaveCodeTitle}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Classes="wizardBody"
                  Text="{x:Static resources:UiStrings.StrictSaveCodeBody}"
                  TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="recoveryCard" Margin="22,16,22,0">
              <StackPanel Spacing="12">
                <!-- Monospace and selectable: the code has to be transcribable by hand
                     as well as copyable, so its characters must not be ambiguous. -->
                <SelectableTextBlock
                    Classes="recoveryCodeText"
                    Text="{Binding RecoveryCodeDisplay}"
                    TextWrapping="Wrap"
                    AutomationProperties.Name="{x:Static resources:UiStrings.RecoveryCodeLabel}" />
                <Border Classes="recoveryDivider" />
                <UniformGrid Rows="1" ColumnSpacing="8">
                  <Button
                      Classes="outline compact"
                      Click="DownloadRecoveryCodeClick"
                      AutomationProperties.Name="{x:Static resources:UiStrings.StrictDownloadCode}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="fluentIcon" Text="&#xE896;" />
                      <TextBlock Text="{x:Static resources:UiStrings.StrictDownloadCode}" />
                    </StackPanel>
                  </Button>
                  <Button
                      Classes="outline compact"
                      Click="PrintRecoveryCodeClick"
                      AutomationProperties.Name="{x:Static resources:UiStrings.StrictPrintCode}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="fluentIcon" Text="&#xE749;" />
                      <TextBlock Text="{x:Static resources:UiStrings.StrictPrintCode}" />
                    </StackPanel>
                  </Button>
                  <Button
                      Classes="outline compact"
                      Click="CopyRecoveryCodeClick"
                      AutomationProperties.Name="{x:Static resources:UiStrings.StrictCopyCode}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="fluentIcon" Text="&#xE8C8;" />
                      <TextBlock Text="{x:Static resources:UiStrings.StrictCopyCode}" />
                    </StackPanel>
                  </Button>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Classes="warningBanner" Margin="22,12,22,0">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <TextBlock Classes="fluentIcon warningIcon" Text="&#xE7BA;" />
                <!-- SelectableTextBlock, not TextBlock, and not for selection: inside this
                     Border a plain TextBlock lays out two lines and paints only the
                     first, so the warning lost its final clause. Verified by dumping the
                     live layout — the control measured 373.6 x 31.2, exactly two lines,
                     with Wrap on and no trimming. -->
                <SelectableTextBlock
                    Grid.Column="1"
                    Classes="warningText"
                    Text="{Binding StrictRecoveryWarning}"
                    TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="wizardFooter" Margin="0,18,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button
                    Classes="outline compact"
                    Content="{x:Static resources:UiStrings.Cancel}"
                    Command="{Binding CancelStrictCommand}"
                    AutomationProperties.Name="Cancel strict focus review" />
                <Button
                    Grid.Column="2"
                    Classes="primary modalPrimary"
                    Content="{x:Static resources:UiStrings.StrictSavedIt}"
                    Click="AdvanceStrictStepClick" />
              </Grid>
            </Border>
          </StackPanel>

          <!-- ════ Step 2: the consequence ═════════════════════════════════ -->
          <StackPanel IsVisible="{Binding IsStrictStepTwo}">
            <StackPanel Margin="22,20,22,0" Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="wizardStep" Text="{x:Static resources:UiStrings.StrictStepTwo}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="stepDot done"><TextBlock Text="&#x2713;" /></Border>
                  <Border Classes="stepRule done" />
                  <Border Classes="stepDot active"><TextBlock Text="2" /></Border>
                </StackPanel>
              </Grid>
              <!-- The title is the consequence itself. "Activate strict mode" names a
                   feature; this names what the user will be living with. -->
              <TextBlock
                  Classes="wizardTitle"
                  Text="{Binding StrictLockTitle}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Classes="wizardBody"
                  Text="{Binding StrictLockSubtitle}"
                  TextWrapping="Wrap" />
            </StackPanel>

            <!-- What it does and does not withstand, in the same list. Claiming it is
                 unbreakable would be false, and a user who discovers the gap later
                 has no reason to trust anything else the app told them. -->
            <Border Classes="recoveryCard" Margin="22,15,22,0">
              <StackPanel Spacing="9">
                <TextBlock
                    Classes="caption"
                    Text="{x:Static resources:UiStrings.StrictDuringThatTime}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                  <TextBlock Classes="fluentIcon resistIcon" Text="&#xE73E;" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="resistText"
                      Text="{x:Static resources:UiStrings.StrictResistsRestart}"
                      TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                  <TextBlock Classes="fluentIcon resistIcon" Text="&#xE73E;" />
                  <TextBlock
                      Grid.Column="1"
                      Classes="resistText"
                      Text="{x:Static resources:UiStrings.StrictResistsRename}"
                      TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                  <TextBlock Classes="fluentIcon limitIcon" Text="&#xE946;" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Classes="limitText"
                        Text="{x:Static resources:UiStrings.StrictAdminLimit}"
                        TextWrapping="Wrap" />
                    <Button
                        Classes="link compact"
                        HorizontalAlignment="Left"
                        Content="{x:Static resources:UiStrings.StrictSeeLimits}"
                        Click="ShowStrictLimitsClick" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border
                Classes="warningBanner"
                Margin="22,13,22,0"
                IsVisible="{Binding HasStrictAppClosures}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <TextBlock Classes="fluentIcon warningIcon" Text="&#xE74E;" />
                <SelectableTextBlock
                    Grid.Column="1"
                    Classes="warningText"
                    Text="{Binding StrictAppClosureWarning}"
                    TextWrapping="Wrap" />
              </Grid>
            </Border>

            <!-- Confirmation is the profile's own name, readable from the screen the
                 user just came from, rather than a random phrase that only tests
                 transcription. -->
            <StackPanel Margin="22,15,22,0" Spacing="7">
              <!-- The token is a monospace pill inline with the sentence, so what has
                   to be typed is unambiguous down to its spacing. -->
              <WrapPanel ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
                <TextBlock
                    Classes="wizardBody"
                    VerticalAlignment="Center"
                    Text="{x:Static resources:UiStrings.StrictTypeToConfirmPrefix}" />
                <Border Classes="confirmToken">
                  <TextBlock Text="{Binding RequiredConfirmationText}" />
                </Border>
                <TextBlock
                    Classes="wizardBody"
                    VerticalAlignment="Center"
                    Text="{x:Static resources:UiStrings.StrictTypeToConfirmSuffix}" />
              </WrapPanel>
              <TextBox
                  x:Name="StrictConfirmationInput"
                  Text="{Binding TypedConfirmation}"
                  PlaceholderText="{x:Static resources:UiStrings.StrictProfileNamePlaceholder}"
                  AutomationProperties.Name="Strict focus confirmation" />
            </StackPanel>

            <Border Classes="wizardFooter" Margin="0,16,0,0">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button
                    Classes="outline compact"
                    Content="{x:Static resources:UiStrings.StrictBack}"
                    Click="ReturnToStrictStepOneClick" />
                <Button
                    Grid.Column="1"
                    Classes="link compact"
                    Content="{x:Static resources:UiStrings.Cancel}"
                    Command="{Binding CancelStrictCommand}"
                    AutomationProperties.Name="Cancel strict focus review" />
                <!-- Destructive, and disabled until the name matches exactly. The
                     commitment is written inside the button that makes it. -->
                <Button
                    Grid.Column="3"
                    Classes="danger modalPrimary"
                    Content="{Binding StrictConfirmButtonText}"
                    Command="{Binding ConfirmStrictCommand}"
                    IsEnabled="{Binding CanConfirmStrict}"
                    AutomationProperties.Name="Activate strict focus after confirmation" />
              </Grid>
            </Border>
          </StackPanel>

          <!-- The limits sheet sits over its own step rather than replacing it, so
               closing it returns the user exactly where they were. -->
          <Border
              Classes="limitsSheet"
              IsVisible="{Binding IsStrictLimitsVisible}">
            <StackPanel Margin="22" Spacing="12">
              <TextBlock
                  Classes="wizardTitle"
                  Text="{x:Static resources:UiStrings.StrictLimitsTitle}"
                  TextWrapping="Wrap" />
              <TextBlock
                  Classes="wizardBody"
                  Text="{x:Static resources:UiStrings.StrictLimitsBody}"
                  TextWrapping="Wrap" />
              <Button
                  Classes="outline compact"
                  HorizontalAlignment="Right"
                  Content="{x:Static resources:UiStrings.StrictLimitsClose}"
                  Click="HideStrictLimitsClick" />
            </StackPanel>
          </Border>
        </Panel></ScrollViewer>
      </Border>
    </Border>
  </Grid>
</Window>
