<UserControl
    x:Class="FocusGuard.Desktop.ActiveFocusView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FocusGuard.Desktop"
    xmlns:resources="using:FocusGuard.Desktop.Resources"
    x:DataType="vm:ActiveFocusViewModel">
  <ScrollViewer>
    <Grid Margin="48,36" RowDefinitions="Auto,Auto,Auto" RowSpacing="22">
      <StackPanel Spacing="8">
        <TextBlock Text="{x:Static resources:UiStrings.InFocusTitle}" FontSize="34" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ProfileName}" Foreground="{DynamicResource FgTextSecondary}" FontSize="16" />
      </StackPanel>

      <Border Grid.Row="1" Classes="card">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="32" RowSpacing="18">
          <StackPanel>
            <TextBlock Text="{x:Static resources:UiStrings.TimeRemaining}" Foreground="{DynamicResource FgTextSecondary}" />
            <TextBlock Text="{Binding RemainingText}" FontSize="64" FontWeight="SemiBold" AutomationProperties.Name="Time remaining" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
            <Border Background="{DynamicResource FgSurfaceElevated}" CornerRadius="{DynamicResource FgRadiusSmall}" Padding="12,8">
              <TextBlock Text="{Binding ModeLabel}" AutomationProperties.Name="Session mode" />
            </Border>
            <TextBlock Text="{Binding ExactEndDisplayText}" Foreground="{DynamicResource FgTextSecondary}" AutomationProperties.Name="Exact session end time" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource FgTextSecondary}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding HealthLabel}" TextWrapping="Wrap" Foreground="{DynamicResource FgSuccess}" AutomationProperties.Name="Enforcement health" />
          <Button Grid.Row="3" Grid.ColumnSpan="2" Classes="primary" Content="{x:Static resources:UiStrings.StopNormalFocus}" Command="{Binding StopFocusCommand}" IsVisible="{Binding CanStop}" AutomationProperties.Name="Stop normal focus session" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="14">
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static resources:UiStrings.WebsitesLabel}" Foreground="{DynamicResource FgTextSecondary}" />
            <TextBlock Text="{Binding WebsiteRuleCount}" FontSize="26" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static resources:UiStrings.ApplicationsLabel}" Foreground="{DynamicResource FgTextSecondary}" />
            <TextBlock Text="{Binding ApplicationRuleCount}" FontSize="26" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static resources:UiStrings.RecentBlocks}" Foreground="{DynamicResource FgTextSecondary}" />
            <TextBlock Text="{Binding RecentBlockCount}" FontSize="26" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
