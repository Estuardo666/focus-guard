<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FocusGuard.Desktop" xmlns:r="using:FocusGuard.Desktop.Resources"
             x:Class="FocusGuard.Desktop.RuleEditorView" x:DataType="vm:FocusViewModel">
  <Grid x:Name="Columns" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16" IsEnabled="{Binding CanEditProfileRules}">
    <Border Classes="card" Padding="16">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding WebsitesHeader}" FontWeight="SemiBold" />
        <TextBox Text="{Binding WebsiteRuleInput}" PlaceholderText="example.com" MaxLength="2048" AutomationProperties.Name="{x:Static r:UiStrings.AddWebsiteRule}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ComboBox ItemsSource="{Binding WebsiteActions}" SelectedItem="{Binding WebsiteAction}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:UiStrings.NewWebsiteActionLabel}" />
          <Button Grid.Column="1" Classes="secondary" Content="{x:Static r:UiStrings.Add}" Command="{Binding AddWebsiteRuleCommand}" IsEnabled="{Binding IsWebsiteValid}" />
        </Grid>
        <SelectableTextBlock Text="{Binding WebsiteValidationText}" TextWrapping="Wrap" Classes="caption" Classes.validationError="{Binding HasWebsiteValidationError}" AutomationProperties.LiveSetting="Polite" />
        <Border Classes="settingRowDivider" />
        <TextBox Text="{Binding WebsiteSearch}" PlaceholderText="{x:Static r:UiStrings.WebsitesLabel}" AutomationProperties.Name="{x:Static r:UiStrings.WebsitesLabel}" />
        <TextBlock Classes="caption" Text="{x:Static r:UiStrings.NoBlockedWebsites}" IsVisible="{Binding !HasSavedWebsiteRules}" />
        <ItemsControl ItemsSource="{Binding FilteredWebsiteRules}"><ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SavedWebsiteRuleViewModel">
            <Grid ColumnDefinitions="*,40" ColumnSpacing="8" Margin="0,0,0,10">
              <StackPanel Spacing="3"><SelectableTextBlock Text="{Binding Rule.Pattern}" TextWrapping="Wrap" /><TextBlock Text="{Binding ActionLabel}" Classes="caption" /></StackPanel>
              <Button Grid.Column="1" Classes="ghost desktopIcon" Content="&#xE711;" Command="{Binding RemoveCommand}" AutomationProperties.Name="{x:Static r:UiStrings.Remove}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </Border>
    <Border x:Name="Applications" Grid.Column="1" Classes="card" Padding="16">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding ApplicationsHeader}" FontWeight="SemiBold" />
        <StackPanel Spacing="6">
          <TextBlock Text="{x:Static r:UiStrings.NewApplicationActionLabel}" Classes="caption" />
          <ComboBox ItemsSource="{Binding ApplicationActions}" SelectedItem="{Binding ApplicationAction}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static r:UiStrings.NewApplicationActionLabel}" />
        </StackPanel>
        <TextBox x:Name="ApplicationSearchBox" Text="{Binding ApplicationSearch}" PlaceholderText="{x:Static r:UiStrings.ApplicationSearchHint}" AutomationProperties.Name="{x:Static r:UiStrings.ProfileSearchShortcut}" />
        <TextBlock Classes="caption" Text="{x:Static r:UiStrings.SavedBlocks}" />
        <ItemsControl ItemsSource="{Binding FilteredApplicationRules}"><ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SavedApplicationRuleViewModel">
            <Grid ColumnDefinitions="32,*,40" ColumnSpacing="8" Margin="0,0,0,10">
              <Panel Width="28" Height="28" VerticalAlignment="Top">
                <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                <TextBlock Classes="fluentIcon" Text="&#xE7C3;" IsVisible="{Binding !HasIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
              <StackPanel Grid.Column="1" Spacing="4">
                <SelectableTextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ActionLabel}" Classes="caption" />
                <Expander Header="{x:Static r:UiStrings.RuleDetails}"><StackPanel Spacing="4"><SelectableTextBlock Text="{Binding Rule.Value}" TextWrapping="Wrap" /><TextBlock Text="{Binding MatchLabel}" Classes="caption" /></StackPanel></Expander>
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost desktopIcon" Content="&#xE711;" Command="{Binding RemoveCommand}" AutomationProperties.Name="{x:Static r:UiStrings.Remove}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Classes="caption" Text="{x:Static r:UiStrings.InstalledApplications}" />
        <TextBlock Classes="caption" Text="{x:Static r:UiStrings.ApplicationCatalogLoading}" IsVisible="{Binding IsLoadingApplications}" />
        <SelectableTextBlock Classes="caption" Text="{x:Static r:UiStrings.ApplicationNoMatches}" IsVisible="{Binding NoApplicationMatches}" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding MatchingApplications}"><ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ApplicationChoiceViewModel">
              <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                <Panel Width="28" Height="28" VerticalAlignment="Center"><Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" /><TextBlock Classes="fluentIcon" Text="&#xE7C3;" IsVisible="{Binding !HasIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Panel>
                <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="secondary compact" Content="{x:Static r:UiStrings.Add}" Command="{Binding AddCommand}" AutomationProperties.Name="{Binding Name}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <Expander Header="{x:Static r:UiStrings.RuleDetails}">
          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBox Text="{Binding ApplicationRuleInput}" PlaceholderText="{x:Static r:UiStrings.ApplicationTechnicalHint}" AutomationProperties.Name="{x:Static r:UiStrings.AddApplicationRule}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8"><Button Classes="secondary" Content="{x:Static r:UiStrings.Add}" Command="{Binding AddApplicationRuleCommand}" /><Button Classes="ghost" Content="{x:Static r:UiStrings.RefreshView}" Command="{Binding RefreshApplicationsCommand}" /></WrapPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
