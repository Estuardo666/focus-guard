<Window
    x:Class="FocusGuard.Desktop.BlockScrimWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowState="FullScreen"
    WindowDecorations="None"
    ShowInTaskbar="False"
    ShowActivated="False"
    CanResize="False"
    Background="{DynamicResource FgModalScrim}"
    Title="FocusGuard">
  <!-- Nothing but the dim. Purely optional ceremony behind the summary card. -->
  <Panel />
</Window>
