{
  "realm": "focusguard",
  "loginTheme": "focusguard",
  "accountTheme": "focusguard",
  "enabled": true,
  "displayName": "FocusGuard",
  "sslRequired": "all",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(15) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": false,
  "adminEventsEnabled": false,
  "requiredActions": [
    {"alias":"UPDATE_PASSWORD","name":"Update Password","providerId":"UPDATE_PASSWORD","enabled":true,"defaultAction":true,"priority":30},
    {"alias":"CONFIGURE_TOTP","name":"Configure OTP","providerId":"CONFIGURE_TOTP","enabled":true,"defaultAction":false,"priority":10},
    {"alias":"VERIFY_EMAIL","name":"Verify Email","providerId":"VERIFY_EMAIL","enabled":true,"defaultAction":true,"priority":20}
  ],
  "clients": [
    {
      "clientId": "focusguard-native",
      "name": "FocusGuard native",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:18444/callback/"],
      "webOrigins": [],
      "attributes": {"pkce.code.challenge.method":"S256","post.logout.redirect.uris":"http://127.0.0.1:18444/callback/"},
      "protocolMappers": [{"name":"focusguard-api-audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","consentRequired":false,"config":{"included.custom.audience":"focusguard-api","access.token.claim":"true","id.token.claim":"false"}}],
      "defaultClientScopes": ["profile","email"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "focusguard-android",
      "name": "FocusGuard Android",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["com.totemmassmedia.focusguard:/oauth2redirect"],
      "webOrigins": [],
      "attributes": {"pkce.code.challenge.method":"S256","post.logout.redirect.uris":"com.totemmassmedia.focusguard:/oauth2redirect"},
      "protocolMappers": [{"name":"focusguard-api-audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","consentRequired":false,"config":{"included.custom.audience":"focusguard-api","access.token.claim":"true","id.token.claim":"false"}}],
      "defaultClientScopes": ["profile","email"],
      "optionalClientScopes": []
    },
    {
      "clientId": "focusguard-bff",
      "name": "FocusGuard web BFF",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://focusguard.totemmassmedia.com/api/auth/callback"],
      "webOrigins": [],
      "attributes": {"pkce.code.challenge.method":"S256","post.logout.redirect.uris":"https://focusguard.totemmassmedia.com/"},
      "protocolMappers": [{"name":"focusguard-api-audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","consentRequired":false,"config":{"included.custom.audience":"focusguard-api","access.token.claim":"true","id.token.claim":"false"}}],
      "defaultClientScopes": ["profile","email"],
      "optionalClientScopes": []
    }
  ]
}
